@model Moonmax.ViewModels.AddPartsViewModel

@{
    ViewData["Title"] = "Add Parts";
    ViewData["Nav"] = "JobOrders";
    ViewData["AppShell"] = true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/joborders.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
}

<div class="page page-add-parts">
    <!-- HEADER -->
    <header class="dash-header">
        <div>
            <h1 class="dash-title">Add Parts</h1>
            <p class="dash-sub">Job #@Model.JobID - @Model.JobClient (@Model.ServiceType)</p>
        </div>
        <div class="dash-actions">
            <a asp-action="Index" class="btn-pill btn-secondary-mm">
                <i class="fa-solid fa-arrow-left btn-ico"></i>
                Back to Job Orders
            </a>
        </div>
    </header>

   

    <!-- FORM TO ADD PART -->
    <section class="add-part-form mt-3 mb-5">
        <form asp-action="AddParts" method="post">
            <input type="hidden" asp-for="JobID" />

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Select Part</label>
                    <select asp-for="InventoryID" class="form-select" asp-items="Model.InventoryItems">
                        <option value="">-- Select Part --</option>
                    </select>
                    <span asp-validation-for="InventoryID" class="text-danger"></span>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Quantity</label>
                    <input asp-for="Quantity" class="form-control" type="number" min="1" />
                    <span asp-validation-for="Quantity" class="text-danger"></span>
                </div>

                <div class="col-md-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">Add Part</button>
                </div>
            </div>
        </form>
    </section>

    <!-- TABLE OF ADDED PARTS -->
    <section class="added-parts-table">
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Part Name</th>
                    <th>Quantity</th>
                    <th>Unit Cost</th>
                    <th>Total Cost</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Parts != null && Model.Parts.Any())
                {
                    foreach (var part in Model.Parts)
                    {
                        <tr>
                            <td>@part.PartName</td>
                            <td>@part.Quantity</td>
                            <td>₱@part.UnitCost.ToString("N2")</td>
                            <td>₱@part.TotalCost.ToString("N2")</td>
                            <td>
                                <a asp-action="RemovePart" asp-route-id="@part.PartID" class="btn btn-sm btn-danger">
                                    <i class="fa-solid fa-trash"></i> Remove
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center">No parts added yet.</td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
</div>

<!-- ERROR MODAL -->
<div class="modal fade" id="errorModal" tabindex="-1" aria-labelledby="errorModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-danger">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="errorModalLabel">Stock Alert</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @TempData["Error"]
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Check if TempData has an error, then show modal
        @if (TempData["Error"] != null)
        {
                <text>
                    var errorModal = new bootstrap.Modal(document.getElementById('errorModal'));
                    errorModal.show();
                </text>
        }
    </script>
}
