@model Moonmax.ViewModels.JobOrderDetailsViewModel

<div class="modal-header">
    <h5 class="modal-title">Job Order #@Model.JobID</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body">
    <div class="row mb-3">
        <div class="col-md-6"><strong>Client:</strong> @Model.Client</div>
        <div class="col-md-6"><strong>Technician:</strong> @Model.Technician</div>
    </div>
    <div class="row mb-3">
        <div class="col-md-6"><strong>Service Type:</strong> @Model.ServiceType</div>
        <div class="col-md-6"><strong>Status:</strong> @Model.Status</div>
    </div>
    <div class="row mb-3">
        <div class="col-md-6"><strong>Created:</strong> @Model.Created.ToString("yyyy-MM-dd")</div>
        <div class="col-md-6"><strong>Due Date:</strong> @(Model.DueDate?.ToString("yyyy-MM-dd") ?? "-")</div>
    </div>
    <div class="row mb-3">
        <div class="col-md-6"><strong>Job Cost:</strong> ₱@Model.Cost.ToString("N0")</div>
        <div class="col-md-6"><strong>Description:</strong> @Model.Description</div>
    </div>

    <hr />

    <h6>Parts Added</h6>
    <table class="table table-sm table-bordered">
        <thead>
            <tr>
                <th>Part Name</th>
                <th>Quantity</th>
                <th>Unit Cost</th>
                <th>Total</th>
            </tr>
        </thead>
        <tbody>
            @{
                decimal totalPartsCost = 0;
                foreach (var part in Model.Parts)
                {
                    var partTotal = part.Quantity * part.UnitCost;
                    totalPartsCost += partTotal;
                }
            }
            @foreach (var part in Model.Parts)
            {
                <tr>
                    <td>@part.PartName</td>
                    <td>@part.Quantity</td>
                    <td>₱@(part.UnitCost.ToString("N0"))</td>
                    <td>₱@((part.Quantity * part.UnitCost).ToString("N0"))</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3" class="text-end">Total Parts Cost:</th>
                <th>₱@(totalPartsCost.ToString("N0"))</th>
            </tr>
            <tr>
                <th colspan="3" class="text-end">Grand Total (Job + Parts):</th>
                <th>₱@((Model.Cost + totalPartsCost).ToString("N0"))</th>
            </tr>
        </tfoot>

    </table>
</div>

<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
</div>
