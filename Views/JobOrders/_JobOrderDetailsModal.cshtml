@model Moonmax.ViewModels.JobOrderDetailsViewModel

<div class="joborder-view p-3">

    <!-- ================= HEADER ================= -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="mb-1">Job Order</h4>
            <small class="text-muted">#@Model.JobID</small>
        </div>
        <span class="badge bg-secondary">@Model.Status</span>
    </div>

    <hr />

    <!-- ================= CLIENT & TECHNICIAN INFO ================= -->
    <div class="row mb-3">
        <div class="col-md-6">
            <p><strong>Client:</strong> @Model.Client</p>
            <p><strong>Created:</strong> @Model.Created.ToString("yyyy-MM-dd")</p>
        </div>
        <div class="col-md-6 text-md-end">
            <p><strong>Technician:</strong> @Model.Technician</p>
            <p><strong>Due Date:</strong> @(Model.DueDate?.ToString("yyyy-MM-dd") ?? "-")</p>
        </div>
    </div>

    <!-- ================= SERVICE INFO ================= -->
    <div class="mb-3">
        <p><strong>Service Type:</strong> @Model.ServiceType</p>
    </div>

    <hr />
    <!-- ================= JOB PARTS ================= -->
    <h6 class="mb-2">Job Parts</h6>

    @if (Model.Parts != null && Model.Parts.Any())
    {
        <table class="table table-sm table-bordered text-center">
            <thead class="table-light">
                <tr>
                    <th>Part Name</th>
                    <th class="text-center">Qty</th>
                    <th class="text-end">Unit Cost</th>
                    <th class="text-end">Total</th>
                </tr>
            </thead>
            <tbody>
                @{
                    decimal totalPartsCost = 0;
                    foreach (var part in Model.Parts)
                    {
                        var partTotal = part.Quantity * part.UnitCost;
                        totalPartsCost += partTotal;
                    }
                }
                @foreach (var part in Model.Parts)
                {
                    <tr>
                        <td>@part.PartName</td>
                        <td class="text-center">@part.Quantity</td>
                        <td class="text-end">₱@part.UnitCost.ToString("N0")</td>                      
                        <td class="text-end">₱@((Model.Cost + Model.Parts.Sum(p => p.Quantity * p.UnitCost)).ToString("N0"))</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted fst-italic">No parts were added to this job.</p>
    }

    <!-- ================= COST SUMMARY ================= -->
    <div class="row justify-content-end mt-3">
        <div class="col-md-6">
            <table class="table table-sm">
                <tr>
                    <th>Labor Cost</th>
                    <td class="text-end">₱@Model.Cost.ToString("N0")</td>
                </tr>
                <tr>
                    <th>Parts Total</th>
                    <td class="text-end">₱@Model.Parts.Sum(p => p.Quantity * p.UnitCost).ToString("N0")</td>
                </tr>
                <tr class="table-active">
                    <th>Total Amount</th>
                    <td class="text-end">₱@((Model.Cost + Model.Parts.Sum(p => p.Quantity * p.UnitCost)).ToString("N0"))</td>
                </tr>
            </table>
        </div>
    </div>

</div>
