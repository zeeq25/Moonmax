@model Moonmax.ViewModels.JobOrdersIndexViewModel

@{
    ViewData["Title"] = "Job Orders & Repair Requests";
    ViewData["Nav"] = "JobOrders";
    ViewData["AppShell"] = true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/tophead.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/joborders.css" asp-append-version="true" />
}

<div class="page page-jobs">
    <!-- HEADER -->
    <header class="dash-header">
        <div>
            <h1 class="dash-title">Job Orders & Repair Requests</h1>
            <p class="dash-sub">Manage repair jobs and service requests</p>
        </div>
        <div class="dash-actions">
            <a asp-controller="JobOrders" asp-action="Create" class="btn-pill btn-primary-mm">
                <span class="btn-ico">+</span>
                <span>Create Job Order</span>
            </a>            
        </div>
    </header>

    <!-- KPI CARDS -->
    <section class="dash-kpis">
        <article class="dash-card kpi">
            <div class="kpi-icon"><i class="fa-regular fa-clock"></i></div>
            <div><div class="kpi-title">Pending Jobs</div><div class="kpi-main">@Model.PendingJobs</div></div>
        </article>
        <article class="dash-card kpi">
            <div class="kpi-icon"><i class="fa-solid fa-rotate-right"></i></div>
            <div><div class="kpi-title">In Progress</div><div class="kpi-main">@Model.InProgressJobs</div></div>
        </article>
        <article class="dash-card kpi">
            <div class="kpi-icon"><i class="fa-solid fa-check"></i></div>
            <div><div class="kpi-title">Completed</div><div class="kpi-main">@Model.CompletedJobs</div></div>
        </article>
        <article class="dash-card kpi">
            <div class="kpi-icon"><i class="fa-solid fa-peso-sign"></i></div>
            <div><div class="kpi-title">Total Revenue</div><div class="kpi-main">₱@Model.TotalRevenue.ToString("N0")</div></div>
        </article>
    </section>

    <!-- SEARCH + TABS ROW -->
    <section class="jo-top-row">
        <div class="jo-search">
            <span class="jo-search-ico"><i class="fa-solid fa-magnifying-glass"></i></span>
            <input type="text" class="jo-search-input" placeholder="Search by job ID, client, or service type..." />
        </div>
        <div class="jo-filter-group">
            <button class="jo-tab jo-tab--active" data-filter="all">All Jobs</button>
            <button class="jo-tab" data-filter="pending">Pending</button>
            <button class="jo-tab" data-filter="in-progress">In Progress</button>
            <button class="jo-tab" data-filter="completed">Completed</button>
        </div>
    </section>

    <!-- TABLE -->
    <div class="table-responsive">
        <table class="jo-table" id="jobOrdersTable">
            <thead>
                <tr>
                    <th>Job ID</th>
                    <th>Client</th>
                    <th>Service Type</th>
                    <th>Technician</th>
                    <th>Created</th>
                    <th>Due Date</th>
                    <th>Job Cost</th>
                    <th>Status</th>
                    <th class="jo-col-actions">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var jo in Model.JobOrders)
                {
                    <tr data-status="@jo.Status.Replace(" ", "-").ToLower()" data-technician-id="@jo.TechnicianID">
                        <td>@jo.JobID</td>
                        <td>@jo.Client</td>
                        <td>@jo.ServiceType</td>
                        <td>@jo.Technician</td>
                        <td>@(jo.Created.ToString("yyyy-MM-dd"))</td>
                        <td>@(jo.DueDate?.ToString("yyyy-MM-dd") ?? "")</td>
                        <td>₱@jo.Cost.ToString("N0")</td>
                        <td><span class="status status-@(jo.Status.Replace(" ", "-").ToLower())">@jo.Status</span></td>
                        <td class="jo-col-actions">
                            <div class="jo-actions">
                                <button class="icon-btn-table btn-view" data-id="@jo.JobID" title="View Job Order">
                                    <i class="fa-regular fa-eye"></i>
                                </button>

                                @* Only show Add Parts for Pending jobs *@
                                @if (string.Equals(jo.Status?.Trim(), "Pending", StringComparison.OrdinalIgnoreCase))
                                {
                                    <a class="icon-btn-table btn-add-parts"
                                       asp-action="AddParts"
                                       asp-route-id="@jo.JobID"
                                       title="Add Parts">
                                        <i class="fa-solid fa-plus"></i>
                                    </a>
                                }

                                @* Only show Create Invoice for In Progress jobs *@
                                @if (string.Equals(jo.Status?.Trim(), "In Progress", StringComparison.OrdinalIgnoreCase))
                                {
                                    <a class="icon-btn-table btn-create-invoice"
                                       asp-action="CreateInvoice"
                                       asp-route-id="@jo.JobID"
                                       title="Create Invoice"
                                       data-job-id="@jo.JobID"
                                       data-client="@jo.Client"
                                       data-cost="@jo.Cost.ToString("C")">
                                        <i class="fa-solid fa-file-invoice"></i>
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>

<!-- Mini Pagination -->
<div class="table-pagination">
    <button class="pg-btn" onclick="changeJobOrdersPage(-1)">‹</button>
    <span id="jobOrdersPageIndicator">Page 1</span>
    <button class="pg-btn" onclick="changeJobOrdersPage(1)">›</button>
</div>


<!-- Modal container for Job Order Details -->
<div class="modal fade" id="jobOrderModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content"></div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const table = document.getElementById("jobOrdersTable");
            const tabs = document.querySelectorAll('.jo-tab');
            const searchInput = document.querySelector('.jo-search-input');
            let currentFilter = 'all';
            let currentPage = 1;
            const rowsPerPage = 10;

            function getFilteredRows() {
                const term = (searchInput.value || '').trim().toLowerCase();
                return Array.from(table.querySelectorAll("tbody tr")).filter(row => {
                    const status = row.dataset.status;
                    const matchesStatus = currentFilter === 'all' || status === currentFilter;
                    const cells = row.querySelectorAll('td');
                    const combinedText = Array.from(cells).slice(0, 4).map(c => c.innerText.toLowerCase()).join(' ');
                    return matchesStatus && (term === '' || combinedText.includes(term));
                });
            }

            function renderTable() {
                const allRows = Array.from(table.querySelectorAll("tbody tr"));
                const filteredRows = getFilteredRows();
                const totalPages = Math.ceil(filteredRows.length / rowsPerPage) || 1;

                // hide all rows
                allRows.forEach(row => row.style.display = "none");

                // show only the current page of filtered rows
                filteredRows.forEach((row, index) => {
                    if (index >= (currentPage - 1) * rowsPerPage &&
                        index < currentPage * rowsPerPage) {
                        row.style.display = "";
                    }
                });

                document.getElementById("jobOrdersPageIndicator").textContent =
                    `Page ${currentPage} of ${totalPages}`;
                document.querySelectorAll(".table-pagination .pg-btn")[0].disabled = currentPage === 1;
                document.querySelectorAll(".table-pagination .pg-btn")[1].disabled = currentPage === totalPages;
            }

            function changePage(step) {
                const filteredRows = getFilteredRows();
                const totalPages = Math.ceil(filteredRows.length / rowsPerPage) || 1;

                currentPage += step;
                if (currentPage < 1) currentPage = 1;
                if (currentPage > totalPages) currentPage = totalPages;

                renderTable();
            }

            // tab click
            tabs.forEach(tab => {
                tab.addEventListener('click', function () {
                    tabs.forEach(t => t.classList.remove('jo-tab--active'));
                    this.classList.add('jo-tab--active');
                    currentFilter = this.dataset.filter;
                    currentPage = 1; // reset to first page
                    renderTable();
                });
            });

            // search input
            if (searchInput) searchInput.addEventListener('input', function () {
                currentPage = 1; // reset page on search
                renderTable();
            });
                      
            // expose pagination function globally
            window.changeJobOrdersPage = changePage;

            // initial render
            renderTable();
        });
    </script>

    <!--Job order modal-->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const modalContainer = document.getElementById('jobOrderModal');

            document.querySelectorAll('.btn-view').forEach(function(btn) {
                btn.addEventListener('click', async function () {
                    const jobId = this.dataset.id;
                    if (!jobId) return;

                    const response = await fetch(`/JobOrders/ViewJobOrderDetailsModal/${jobId}`);
                    const html = await response.text();

                    modalContainer.querySelector('.modal-content').innerHTML = html;
                    new bootstrap.Modal(modalContainer).show();
                });
            });
        });
    </script>

    <!-- Add this script in the  Scripts block -->
    <script>
    // Create Invoice Confirmation
    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.btn-create-invoice').forEach(button => {
            button.addEventListener('click', function (e) {
                e.preventDefault();

                const jobId = this.dataset.jobId;
                const client = this.dataset.client;
                const cost = this.dataset.cost;
                const url = this.href;

                Swal.fire({
                    title: 'Create Invoice?',
                    html: `
                        <div style="text-align:left">
                            <p><strong>Job ID:</strong> ${jobId}</p>
                            <p><strong>Client:</strong> ${client}</p>
                            <p><strong>Cost:</strong> ${cost}</p>
                            <hr>
                            <p>This will create a new invoice for this job.</p>
                        </div>
                    `,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, Create Invoice',
                    cancelButtonText: 'Cancel',
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#6c757d',
                    reverseButtons: true
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = url;
                    }
                });
            });
        });
    });
    </script>

    
}

