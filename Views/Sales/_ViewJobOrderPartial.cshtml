@model Moonmax.Models.JobOrder

<div class="joborder-view p-3" style="max-width:600px; margin:auto; font-family: Arial, sans-serif;">

    @if (Model != null)
    {
        <!-- ================= HEADER ================= -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h4 class="mb-1">Job Order</h4>
                <small class="text-muted">#@Model.JobID</small>
            </div>
            <span class="badge @(Model.Status == "Completed" ? "bg-success" : Model.Status == "In Progress" ? "bg-warning" : "bg-secondary")">
                @Model.Status
            </span>
        </div>

        <hr />

        <!-- ================= CLIENT & JOB INFO ================= -->
        <div class="row mb-3">
            <div class="col-md-6">
                <p><strong>Client:</strong> @(Model.Client?.Name ?? $"Walk-In ({Model.ContactNumber ?? "N/A"})")</p>
                <p><strong>Contact:</strong> @(Model.Client?.ContactNumber ?? Model.ContactNumber ?? "-")</p>
            </div>
            <div class="col-md-6 text-md-end">
                <p><strong>Technician:</strong> @(Model.Technician?.Name ?? "N/A")</p>
                <p><strong>Created At:</strong> @Model.CreatedAt.ToString("yyyy-MM-dd")</p>
                <p><strong>Due Date:</strong> @(Model.DueDate?.ToString("yyyy-MM-dd") ?? "-")</p>
            </div>
        </div>

        <!-- ================= SERVICE INFO ================= -->
        <div class="mb-3">
            <p><strong>Service Type:</strong> @Model.ServiceType</p>
        </div>

        <hr />

        <!-- ================= JOB PARTS ================= -->
        <h6 class="mb-2">Job Parts</h6>
        @if (Model.JobParts != null && Model.JobParts.Any())
        {
            <table class="table table-sm table-bordered">
                <thead class="table-light">
                    <tr>
                        <th>Part</th>
                        <th class="text-center">Qty</th>
                        <th class="text-end">Unit Cost</th>
                        <th class="text-end">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var part in Model.JobParts)
                    {
                        <tr>
                            <td>@(part.Inventory?.PartName ?? "N/A")</td>
                            <td class="text-center">@part.Quantity</td>
                            <td class="text-end">₱@part.UnitCost.ToString("N2")</td>
                            <td class="text-end">₱@part.TotalCost.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted fst-italic">No parts were added to this job.</p>
        }

        <!-- ================= COST SUMMARY ================= -->
        <div class="row justify-content-end mt-3">
            <div class="col-md-6">
                <table class="table table-sm">
                    <tr>
                        <th>Labor Cost</th>
                        <td class="text-end">₱@Model.Cost.ToString("N2")</td>
                    </tr>
                    <tr>
                        <th>Parts Total</th>
                        <td class="text-end">
                            ₱@(Model.JobParts?.Sum(p => p.TotalCost).ToString("N2") ?? "0.00")
                        </td>
                    </tr>
                    <tr class="table-active">
                        <th>Total Amount</th>
                        <th class="text-end">
                            ₱@((Model.Cost + (Model.JobParts?.Sum(p => p.TotalCost) ?? 0)).ToString("N2"))
                        </th>
                    </tr>
                </table>
            </div>
        </div>
    }
    else
    {
        <p class="text-danger text-center">Job not found.</p>
    }
</div>
