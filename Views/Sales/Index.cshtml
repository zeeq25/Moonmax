@model Moonmax.ViewModels.SalesIndexViewModel

@{
    ViewData["Title"] = "Sales & Billing";
    ViewData["Nav"] = "Sales";
    ViewData["AppShell"] = true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/tophead.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/sales.css" asp-append-version="true" />

}

<div class="page page-sales">

    <!-- PAGE HEADER -->
    <header class="dash-header">
        <div>
            <h1 class="dash-title">Sales &amp; Billing</h1>
            <p class="dash-sub">Manage customer transactions and invoices</p>
        </div>
    </header>

    <!-- KPI CARDS -->
    <section class="dash-kpis">
        <article class="dash-card kpi">
            <div class="kpi-icon"><i class="fa-solid fa-receipt"></i></div>
            <div class="kpi-content">
                <div class="kpi-title">Total Sales (Oct)</div>
                <div class="kpi-main">₱284,500</div>
            </div>
        </article>
        <article class="dash-card kpi">
            <div class="kpi-icon"><i class="fa-solid fa-money-bill-1-wave"></i></div>
            <div class="kpi-content">
                <div class="kpi-title">Paid Invoices</div>
                <div class="kpi-main">₱92,000</div>
            </div>
        </article>
        <article class="dash-card kpi">
            <div class="kpi-icon"><i class="fa-solid fa-file-invoice-dollar"></i></div>
            <div class="kpi-content">
                <div class="kpi-title">Pending PDCs</div>
                <div class="kpi-main">₱20,500</div>
            </div>
        </article>
        <article class="dash-card kpi">
            <div class="kpi-icon"><i class="fa-solid fa-user-group"></i></div>
            <div class="kpi-content">
                <div class="kpi-title">Active Customers</div>
                <div class="kpi-main">10</div>
            </div>
        </article>
    </section>

    <!-- TABS -->
    <section class="inv-tabs-bar">
        <div class="inv-tabs">
            <a asp-controller="Sales" asp-action="Index" class="inv-tab inv-tab--active">Transactions</a>
            <a asp-controller="Sales" asp-action="Customerlist" class="inv-tab">Customer List</a>
        </div>
    </section>

    <!-- SEARCH + FILTER / EXPORT -->
    <section class="inv-filter-bar">
        <div class="inv-search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input class="inv-search-input" type="text" placeholder="Search by invoice, customer, or job ID..." />
        </div>
        <div class="inv-filter-actions">
            <button class="btn-chip"><i class="fa-solid fa-filter"></i><span>Filter</span></button>
            <button class="btn-chip"><i class="fa-solid fa-download"></i><span>Export</span></button>
        </div>
    </section>

    <!-- TABLE: TRANSACTIONS -->
    <section class="inv-table-wrap">
        <div class="mm-card">
            <table class="mm-table" id="salesTable">
                <thead>
                    <tr>
                        <th>Invoice ID</th>
                        <th>Client</th>
                        <th>Job ID</th>
                        <th>Amount</th>
                        <th>Payment Type</th>
                        <th>Date Issued</th>
                        <th>Due Date</th>
                        <th>Status</th>
                        <th class="col-actions">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var invoice in Model.Invoices)
                    {
                        <tr>
                            <td>@invoice.InvoiceNumber</td>
                            <td>@invoice.ClientName</td>
                            <td>@invoice.JobID</td>
                            <td>@invoice.Amount.ToString("C")</td>
                            <td>@invoice.PaymentType</td>
                            <td>@invoice.DateIssued.ToString("yyyy-MM-dd")</td>
                            <td>@(invoice.DueDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                            <td>
                                <span class="status @(invoice.Status.ToLower() == "pending" ? "status-pending" :
                                                                                             invoice.Status.ToLower() == "paid" ? "status-paid" :
                                                                                             "status-warn")">
                                @invoice.Status
                            </span>
                        </td>
                        <td class="inv-actions">
                            <div class="sales-actions">
                                <a asp-action="ViewInvoice" asp-route-id="@invoice.InvoiceID" class="icon-btn-table btn-view" title="View invoice">
                                    <i class="fa-regular fa-eye"></i>
                                </a>

                                    <!-- Receive Payment button -->
                                    <form asp-action="ReceivePayment" asp-route-id="@invoice.InvoiceID" method="post" style="display:inline;">
                                        <button type="submit" class="icon-btn-table btn-receive"
                                                title="Receive payment"
                                                @(invoice.Status.ToLower() == "paid" ? "disabled" : "")>
                                            <i class="fa-solid fa-check"></i>
                                        </button>
                                    </form>

                                    <!-- Cancel button disabled if Paid -->
                                    <form asp-action="CancelInvoice" asp-route-id="@invoice.InvoiceID" method="post" style="display:inline;">
                                        <button type="submit" class="icon-btn-table btn-cancel"
                                                title="Cancel invoice"
                                                @(invoice.Status.ToLower() == "paid" ? "disabled" : "")>
                                            <i class="fa-solid fa-xmark"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                                        }

                    @foreach (var job in Model.InProgressJobs)
                    {
                        <tr>
                            <td>-</td>
                            <td>@job.Client</td>
                            <td>@job.JobID</td>
                            <td>@job.Cost.ToString("C")</td>
                            <td>-</td>
                            <td>-</td>
                            <td>-</td>
                            <td><span class="status status-warn">In Progress</span></td>
                            <td class="inv-actions">
                                <a asp-action="CreateInvoice" asp-route-jobId="@job.JobID" class="icon-btn-table btn-create" title="Create Invoice">
                                    <i class="fa-solid fa-plus"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <!-- PAGINATION -->
    <div class="table-pagination">
        <button class="pg-btn" onclick="changePage(-1)">‹</button>
        <span id="pageIndicator">Page 1</span>
        <button class="pg-btn" onclick="changePage(1)">›</button>
    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // SEARCH
            const searchInput = document.querySelector('.page-sales .inv-search-input');
            const table = document.querySelector('.page-sales .mm-table');
            if (searchInput && table) {
                const rows = table.querySelectorAll('tbody tr');
                searchInput.addEventListener('input', function () {
                    const query = this.value.trim().toLowerCase();
                    rows.forEach(row => {
                        const text = row.textContent.toLowerCase();
                        row.style.display = text.includes(query) ? '' : 'none';
                    });
                });
            }

            // DISABLE RECEIVE PAYMENT BUTTONS & UPDATE STATUS
            document.querySelectorAll('.btn-receive').forEach(button => {
                button.addEventListener('click', function (e) {
                    // Prevent instant reload (form will still submit)
                    setTimeout(() => {
                        // Disable this receive button
                        button.disabled = true;

                        // Disable cancel button in the same row
                        const cancelBtn = button.closest('tr').querySelector('.btn-cancel');
                        if (cancelBtn) cancelBtn.disabled = true;

                        // Update status cell to Paid
                        const statusEl = button.closest('tr').querySelector('.status');
                        if (statusEl) {
                            statusEl.textContent = 'Paid';
                            statusEl.className = 'status status-paid';
                        }
                    }, 10); // tiny delay to allow form submission
                });
            });
        });

        // Pagination
        const rowsPerPage = 10;
        let currentPage = 1;

        function renderTablePage() {
            const table = document.getElementById("salesTable");
            const rows = table.querySelectorAll("tbody tr");
            const totalPages = Math.ceil(rows.length / rowsPerPage);

            rows.forEach((row, index) => {
                row.style.display =
                    index >= (currentPage - 1) * rowsPerPage &&
                    index < currentPage * rowsPerPage
                        ? ""
                        : "none";
            });

            document.getElementById("pageIndicator").textContent =
                `Page ${currentPage} of ${totalPages}`;
            document.querySelectorAll(".pg-btn")[0].disabled = currentPage === 1;
            document.querySelectorAll(".pg-btn")[1].disabled = currentPage === totalPages;
        }

        function changePage(step) {
            const table = document.getElementById("salesTable");
            const rows = table.querySelectorAll("tbody tr");
            const totalPages = Math.ceil(rows.length / rowsPerPage);

            currentPage += step;
            if (currentPage < 1) currentPage = 1;
            if (currentPage > totalPages) currentPage = totalPages;

            renderTablePage();
        }

        renderTablePage();
    </script>
}
