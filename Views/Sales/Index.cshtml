@model Moonmax.ViewModels.SalesIndexViewModel

@{
    ViewData["Title"] = "Sales & Billing";
    ViewData["Nav"] = "Sales";
    ViewData["AppShell"] = true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/tophead.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/sales.css" asp-append-version="true" />
}

<div class="page page-sales">
    <header class="dash-header">
        <div>
            <h1 class="dash-title">Sales &amp; Billing</h1>
            <p class="dash-sub">Manage customer transactions and invoices</p>
        </div>
    </header>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success" style="background:#d4edda;color:#155724;padding:12px;border-radius:6px;margin-bottom:20px;border:1px solid #c3e6cb;">
            <i class="fa-solid fa-check-circle"></i> @TempData["Success"]
        </div>
    }

    <section class="dash-kpis">
        <article class="dash-card kpi">
            <div class="kpi-icon"><i class="fa-solid fa-receipt"></i></div>
            <div class="kpi-content">
                <div class="kpi-title">Total Value</div>
                <div class="kpi-main">₱@Model.TotalSales.ToString("N2")</div>
            </div>
        </article>
        <article class="dash-card kpi">
            <div class="kpi-icon"><i class="fa-solid fa-money-bill-1-wave"></i></div>
            <div class="kpi-content">
                <div class="kpi-title">Paid Invoices</div>
                <div class="kpi-main">₱@Model.PaidInvoices.ToString("N2")</div>
            </div>
        </article>
        <article class="dash-card kpi">
            <div class="kpi-icon"><i class="fa-solid fa-file-invoice-dollar"></i></div>
            <div class="kpi-content">
                <div class="kpi-title">Pending PDCs</div>
                <div class="kpi-main">₱@Model.PendingPDCs.ToString("N2")</div>
            </div>
        </article>
        <article class="dash-card kpi">
            <div class="kpi-icon"><i class="fa-solid fa-user-group"></i></div>
            <div class="kpi-content">
                <div class="kpi-title">Active Customers</div>
                <div class="kpi-main">@Model.ActiveCustomers</div>
            </div>
        </article>
    </section>

    <section class="inv-tabs-bar">
        <div class="inv-tabs">
            <a asp-controller="Sales" asp-action="Index" class="inv-tab inv-tab--active">Transactions</a>
            <a asp-controller="Sales" asp-action="PaymentHistory" class="inv-tab">Payment History</a>
            <a asp-controller="Sales" asp-action="Customerlist" class="inv-tab">Customer List</a>
        </div>
    </section>

    <section class="inv-table-wrap">
        <section class="inv-filter-bar">
            <div class="inv-search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input class="inv-search-input" type="text" placeholder="Search by invoice, customer, or job ID..." />
            </div>
            <div class="inv-filter-actions">
                <div class="inv-filter-actions">
                    <select id="statusFilter" class="btn-chip">
                        <option value="all">All</option>
                        <option value="pending">Pending</option>
                        <option value="paid">Paid</option>
                        <option value="partially paid">Partially Paid</option>
                        <option value="failed">Failed</option>
                    </select>
                </div>
            </div>
        </section>

        <div class="mm-card">
            <table class="mm-table" id="salesTable">
                <thead>
                    <tr>
                        <th>Invoice ID</th>
                        <th>Client</th>
                        <th>Job ID</th>
                        <th>Amount</th>
                        <th>Payment Type</th>
                        <th>Date Issued</th>
                        <th>Due Date</th>
                        <th>Status</th>
                        <th class="col-actions">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var invoice in Model.Invoices)
                    {
                        <tr>
                            <td>@invoice.InvoiceNumber</td>
                            <td>@invoice.ClientName</td>
                            <td>@invoice.JobID</td>
                            <td>₱@invoice.Amount.ToString("N2")</td>
                            <td>@invoice.PaymentType</td>
                            <td>@invoice.DateIssued.ToString("yyyy-MM-dd")</td>
                            <td>@(invoice.DueDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                            <td>
                                <span class="status @(invoice.Status.ToLower() == "pending" ? "status-pending" :
                                                                            invoice.Status.ToLower() == "paid" ? "status-paid" :
                                                                                         "status-warn")">
                                @invoice.Status
                            </span>
                        </td>
                        <td class="inv-actions">
                            <div class="sales-actions">
                                <button type="button" class="icon-btn-table btn-view" title="View invoice"
                                        data-invoice-id="@invoice.InvoiceID">
                                    <i class="fa-regular fa-eye"></i>
                                </button>

                                    @if     (invoice.Status.ToLower() != "paid" && invoice.Status.ToLower() != "partially paid")
                                    {
                                            <button type="button" class="icon-btn-table btn-receive" title="Process payment"
                                                data-invoice-id="@invoice.InvoiceID">
                                            <i class="fa-solid fa-check"></i>
                                            </button>
                                    }
                                    @if (invoice.Status.ToLower() == "partially paid" && invoice.PaymentType.Contains("PDC"))
                                    {
                                        <button type="button" class="icon-btn-table btn-clear-check" title="Clear check"
                                                data-invoice-id="@invoice.InvoiceID"
                                                style="background:#0891b2; border: 1px solid #0e7490;">
                                            <i class="fa-solid fa-stamp"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <div class="table-pagination" id="invoicePagination">
        <button class="pg-btn" id="invoicePrev">‹</button>
        <span id="invoicePageIndicator">Page 1</span>
        <button class="pg-btn" id="invoiceNext">›</button>
    </div>

    <div id="invoiceModal" class="modal">
        <div class="modal-content">
            <span class="close">&times;</span>
            <div id="invoiceModalBody"></div>
        </div>
    </div>

    <div id="paymentModal" class="modal">
        <div class="modal-content" style="max-width: 600px;">
            <span class="close" id="paymentModalClose">&times;</span>
            <h2 style="margin-bottom: 20px;">Process Payment</h2>

            <form id="paymentForm" method="post" asp-action="ProcessPayment" asp-controller="Sales">
                @Html.AntiForgeryToken()
                <input type="hidden" id="invoiceIdInput" name="InvoiceID" />

                <div class="invoice-summary" style="background:#f8f9fa;padding:15px;border-radius:8px;margin-bottom:20px;">
                    <div><strong>Invoice No:</strong> <span id="summaryInvoiceNo">-</span></div>
                    <div><strong>Client:</strong> <span id="summaryClient">-</span></div>
                    <div><strong>Job ID:</strong> <span id="summaryJobId">-</span></div>
                    <div><strong>Amount:</strong> <span id="summaryAmount">-</span></div>
                    <div><strong>Payment Type:</strong> <span id="summaryPaymentType">-</span></div>
                </div>

                <div style="margin-bottom:20px;">
                    <label for="paymentMethod">Payment Method *</label>
                    <select id="paymentMethod" name="PaymentMethod" required style="width:100%;padding:10px;border-radius:6px;border:1px solid #ddd;">
                        <option value="">-- Select Payment Method --</option>
                        <option value="Cash">Cash</option>
                        <option value="Check">Check (PDC)</option>
                    </select>
                </div>

                <div style="margin-bottom:20px;">
                    <label for="amountPaid">Amount Paid *</label>
                    <input type="number"
                           step="0.01"
                           min="0"
                           id="amountPaid"
                           name="AmountPaid"
                           required
                           placeholder="0.00"
                           style="width:100%;padding:10px;border-radius:6px;border:1px solid #ddd;" />
                </div>

                <div id="checkFields" style="display:none; background:#fff8e1; padding:15px;border-radius:8px;margin-bottom:20px;">
                    <div style="margin-bottom:15px;">
                        <label for="checkNumber">Check Number *</label>
                        <input type="text"
                               name="CheckNumber"
                               id="checkNumber"
                               placeholder="123456"
                               style="width:100%;padding:10px;border-radius:6px;border:1px solid #ddd;">
                    </div>
                    <div style="margin-bottom:15px;">
                        <label for="bankName">Bank Name *</label>
                        <input type="text"
                               name="BankName"
                               id="bankName"
                               placeholder="BDO, BPI"
                               style="width:100%;padding:10px;border-radius:6px;border:1px solid #ddd;">
                    </div>
                    <div>
                        <label for="checkDate">Check Date *</label>
                        <input type="date"
                               name="CheckDate"
                               id="checkDate"
                               style="width:100%;padding:10px;border-radius:6px;border:1px solid #ddd;">
                    </div>
                </div>

                <div style="margin-bottom:20px;">
                    <label for="paymentDate">Payment Date *</label>
                    <input type="date"
                           name="PaymentDate"
                           id="paymentDate"
                           required
                           style="width:100%;padding:10px;border-radius:6px;border:1px solid #ddd;">
                </div>

                <div style="margin-bottom:20px;">
                    <label for="referenceNumber">Reference Number</label>
                    <input type="text"
                           name="ReferenceNumber"
                           id="referenceNumber"
                           placeholder="Receipt/Transaction No"
                           style="width:100%;padding:10px;border-radius:6px;border:1px solid #ddd;">
                </div>
                <div style="margin-bottom:20px;">
                    <label for="paymentNotes">Notes</label>
                    <textarea name="Notes"
                              id="paymentNotes"
                              rows="3"
                              placeholder="Additional notes..."
                              style="width:100%;padding:10px;border-radius:6px;border:1px solid #ddd;"></textarea>
                </div>

                <div style="display:flex; gap:10px; justify-content:flex-end;">
                    <button type="button"
                            id="cancelPaymentBtn"
                            style="padding:10px 20px; background:#6c757d;color:white;border:none;border-radius:6px;cursor:pointer;">
                        Cancel
                    </button>
                    <button type="submit"
                            id="submitPaymentBtn"
                            style="padding:10px 30px; background:#2563eb;color:white;border:none;border-radius:6px;cursor:pointer;">
                        <span class="btn-text">Process Payment</span>
                        <span class="btn-spinner" style="display:none;">
                            <i class="fa-solid fa-spinner fa-spin"></i> Processing...
                        </span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.btn-clear-check').forEach(btn => {
                btn.addEventListener('click', function () {
                    const invoiceId = this.dataset.invoiceId;
                    const row = this.closest('tr');
                    const invoiceNo = row.children[0].textContent.trim();
                    const client = row.children[1].textContent.trim();

                    Swal.fire({
                        title: 'Clear Check Payment?',
                        html: `
                            <div style="text-align:left; color:#333;">
                                <p><strong>Invoice:</strong> ${invoiceNo}</p>
                                <p><strong>Client:</strong> ${client}</p>
                                <hr>
                                <p>This will mark the check as <b>CLEARED</b> and complete the payment.</p>
                            </div>
                        `,
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonText: 'Yes, Clear Check',
                        cancelButtonText: 'Cancel',
                        confirmButtonColor: '#0891b2',
                        cancelButtonColor: '#6c757d',
                        reverseButtons: true
                    }).then((result) => {
                        if (result.isConfirmed) {
                            const form = document.createElement('form');
                            form.method = 'POST';
                            form.action = '/Sales/ClearCheck';

                            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                            const tokenInput = document.createElement('input');
                            tokenInput.type = 'hidden';
                            tokenInput.name = '__RequestVerificationToken';
                            tokenInput.value = token;

                            const invoiceInput = document.createElement('input');
                            invoiceInput.type = 'hidden';
                            invoiceInput.name = 'invoiceId';
                            invoiceInput.value = invoiceId;

                            form.appendChild(tokenInput);
                            form.appendChild(invoiceInput);
                            document.body.appendChild(form);
                            form.submit();
                        }
                    });
                });
            });
        });
    </script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const modal = document.getElementById("invoiceModal");
            const modalBody = document.getElementById("invoiceModalBody");
            const closeBtn = modal.querySelector(".close");

            document.querySelectorAll('.btn-view').forEach(button => {
                button.addEventListener('click', function () {
                    const invoiceId = this.dataset.invoiceId;
                    fetch(`/Sales/ViewInvoicePartial/${invoiceId}`)
                        .then(response => response.text())
                        .then(html => {
                            modalBody.innerHTML = html;
                            modal.style.display = "block";
                        });
                });
            });

            closeBtn.onclick = () => modal.style.display = "none";
            window.onclick = e => { if (e.target === modal) modal.style.display = "none"; };
        });
    </script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const table = document.getElementById('salesTable');
            const searchInput = document.querySelector('.inv-search-input');
            const statusFilter = document.getElementById('statusFilter');
            const rowsPerPage = 10;
            let currentPage = 1;
            let currentFilter = 'all';

            function getFilteredRows() {
                const term = (searchInput.value || '').trim().toLowerCase();
                return Array.from(table.querySelectorAll('tbody tr')).filter(row => {
                    const statusEl = row.querySelector('.status');
                    const statusText = statusEl ? statusEl.textContent.trim().toLowerCase() : '';
                    const matchesStatus = currentFilter === 'all' || statusText === currentFilter;
                    const rowText = Array.from(row.querySelectorAll('td')).slice(0, 7).map(td => td.textContent.toLowerCase()).join(' ');
                    const matchesSearch = rowText.includes(term);
                    return matchesStatus && matchesSearch;
                });
            }

            function renderTablePage() {
                const filteredRows = getFilteredRows();
                const totalPages = Math.ceil(filteredRows.length / rowsPerPage) || 1;
                table.querySelectorAll('tbody tr').forEach(r => r.style.display = 'none');
                filteredRows.forEach((row, index) => {
                    if (index >= (currentPage - 1) * rowsPerPage && index < currentPage * rowsPerPage) {
                        row.style.display = '';
                    }
                });
                document.getElementById('invoicePageIndicator').textContent = `Page ${currentPage} of ${totalPages}`;
                document.getElementById('invoicePrev').disabled = currentPage === 1;
                document.getElementById('invoiceNext').disabled = currentPage === totalPages;
            }

            document.getElementById('invoicePrev').addEventListener('click', () => {
                if (currentPage > 1) { currentPage--; renderTablePage(); }
            });

            document.getElementById('invoiceNext').addEventListener('click', () => {
                const filteredRows = getFilteredRows();
                const totalPages = Math.ceil(filteredRows.length / rowsPerPage) || 1;
                if (currentPage < totalPages) { currentPage++; renderTablePage(); }
            });

            searchInput.addEventListener('input', () => { currentPage = 1; renderTablePage(); });
            statusFilter.addEventListener('change', function() {
                currentFilter = this.value;
                currentPage = 1;
                renderTablePage();
            });

            renderTablePage();
        });
    </script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const paymentModal = document.getElementById('paymentModal');
            const paymentForm = document.getElementById('paymentForm');
            const invoiceIdInput = document.getElementById('invoiceIdInput');
            const paymentMethod = document.getElementById('paymentMethod');
            const checkFields = document.getElementById('checkFields');
            const checkNumber = document.getElementById('checkNumber');
            const bankName = document.getElementById('bankName');
            const checkDate = document.getElementById('checkDate');
            const referenceNumber = document.getElementById('referenceNumber');
            const submitBtn = document.getElementById('submitPaymentBtn');

            paymentMethod.addEventListener('change', function() {
                if (this.value === 'Check') {
                    checkFields.style.display = 'block';
                    checkNumber.setAttribute('required', 'required');
                    bankName.setAttribute('required', 'required');
                    checkDate.setAttribute('required', 'required');
                    referenceNumber.value = '';
                } else if (this.value === 'Cash') {
                    checkFields.style.display = 'none';
                    checkNumber.removeAttribute('required');
                    bankName.removeAttribute('required');
                    checkDate.removeAttribute('required');
                    checkNumber.value = '';
                    bankName.value = '';
                    checkDate.value = '';
                    const now = new Date();
                    const dateStr = now.toISOString().slice(0,10).replace(/-/g,'');
                    referenceNumber.value = `CASH-${dateStr}`;
                } else {
                    checkFields.style.display = 'none';
                    checkNumber.removeAttribute('required');
                    bankName.removeAttribute('required');
                    checkDate.removeAttribute('required');
                    referenceNumber.value = '';
                }
            });

            document.getElementById('paymentModalClose').addEventListener('click', () => paymentModal.style.display = 'none');
            document.getElementById('cancelPaymentBtn').addEventListener('click', () => paymentModal.style.display = 'none');
            window.addEventListener('click', e => { if (e.target === paymentModal) paymentModal.style.display = 'none'; });

            paymentForm.addEventListener('submit', function(e) {
                const method = paymentMethod.value;

                if (!method) {
                    e.preventDefault();
                    alert('Please select a payment method');
                    return false;
                }

                if (!document.getElementById('amountPaid').value) {
                    e.preventDefault();
                    alert('Please enter the amount paid');
                    return false;
                }

                if (!document.getElementById('paymentDate').value) {
                    e.preventDefault();
                    alert('Please select the payment date');
                    return false;
                }

                if (method === 'Cash') {
                    checkNumber.value = '';
                    bankName.value = '';
                    checkDate.value = '';
                    checkNumber.disabled = true;
                    bankName.disabled = true;
                    checkDate.disabled = true;
                }

                if (method === 'Check') {
                    if (!checkNumber.value || !bankName.value || !checkDate.value) {
                        e.preventDefault();
                        alert('Please fill in all check details.');
                        return false;
                    }
                }

                // Disable button and show loading state
                submitBtn.disabled = true;
                submitBtn.style.opacity = '0.6';
                submitBtn.style.cursor = 'not-allowed';
                submitBtn.querySelector('.btn-text').style.display = 'none';
                submitBtn.querySelector('.btn-spinner').style.display = 'inline';
            });

            document.querySelectorAll('.btn-receive').forEach(btn => {
                btn.addEventListener('click', function (e) {
                    e.preventDefault();
                    const row = btn.closest('tr');
                    const invoiceId = btn.dataset.invoiceId;
                    const invoiceNo = row.children[0].textContent.trim();
                    const client = row.children[1].textContent.trim();
                    const jobId = row.children[2].textContent.trim();
                    const amountText = row.children[3].textContent.trim();
                    const payType = row.children[4].textContent.trim();
                    const amount = parseFloat(amountText.replace(/[₱,]/g, ''));

                    // Reset form state
                    submitBtn.disabled = false;
                    submitBtn.style.opacity = '1';
                    submitBtn.style.cursor = 'pointer';
                    submitBtn.querySelector('.btn-text').style.display = 'inline';
                    submitBtn.querySelector('.btn-spinner').style.display = 'none';

                    invoiceIdInput.value = invoiceId;
                    document.getElementById('summaryInvoiceNo').textContent = invoiceNo;
                    document.getElementById('summaryClient').textContent = client;
                    document.getElementById('summaryJobId').textContent = jobId;
                    document.getElementById('summaryAmount').textContent = amountText;
                    document.getElementById('summaryPaymentType').textContent = payType;

                    if (payType.includes('PDC') || payType.includes('Check')) {
                        paymentMethod.value = 'Check';
                        checkFields.style.display = 'block';
                        checkNumber.setAttribute('required', 'required');
                        bankName.setAttribute('required', 'required');
                        checkDate.setAttribute('required', 'required');
                    } else {
                        paymentMethod.value = 'Cash';
                        checkFields.style.display = 'none';
                        checkNumber.removeAttribute('required');
                        bankName.removeAttribute('required');
                        checkDate.removeAttribute('required');
                    }

                    document.getElementById('amountPaid').value = amount.toFixed(2);
                    checkNumber.value = '';
                    bankName.value = '';
                    checkDate.value = '';

                    const today = new Date();
                    const todayString = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`;
                    document.getElementById('paymentDate').value = todayString;
                    referenceNumber.value = '';
                    document.getElementById('paymentNotes').value = '';
                    paymentMethod.dispatchEvent(new Event('change'));
                    paymentModal.style.display = 'block';
                });
            });
        });
    </script>
}