@model Moonmax.ViewModels.SalesIndexViewModel

@{
    ViewData["Title"] = "Sales & Billing";
    ViewData["Nav"] = "Sales";
    ViewData["AppShell"] = true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/tophead.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/sales.css" asp-append-version="true" />

}

<div class="page page-sales">

    <!-- PAGE HEADER -->
    <header class="dash-header">
        <div>
            <h1 class="dash-title">Sales &amp; Billing</h1>
            <p class="dash-sub">Manage customer transactions and invoices</p>
        </div>
    </header>

    <!-- KPI CARDS -->
    <section class="dash-kpis">
        <article class="dash-card kpi">
            <div class="kpi-icon"><i class="fa-solid fa-receipt"></i></div>
            <div class="kpi-content">
                <div class="kpi-title">Total Value</div>
                <div class="kpi-main">₱@Model.TotalSales.ToString("N2")</div>
            </div>
        </article>
        <article class="dash-card kpi">
            <div class="kpi-icon"><i class="fa-solid fa-money-bill-1-wave"></i></div>
            <div class="kpi-content">
                <div class="kpi-title">Paid Invoices</div>
                <div class="kpi-main">₱@Model.PaidInvoices.ToString("N2")</div>
            </div>
        </article>
        <article class="dash-card kpi">
            <div class="kpi-icon"><i class="fa-solid fa-file-invoice-dollar"></i></div>
            <div class="kpi-content">
                <div class="kpi-title">Pending PDCs</div>
                <div class="kpi-main">₱@Model.PendingPDCs.ToString("N2")</div>
            </div>
        </article>
        <article class="dash-card kpi">
            <div class="kpi-icon"><i class="fa-solid fa-user-group"></i></div>
            <div class="kpi-content">
                <div class="kpi-title">Active Customers</div>
                <div class="kpi-main">@Model.ActiveCustomers</div>
            </div>
        </article>
    </section>



    <!-- TABS -->
    <section class="inv-tabs-bar">
        <div class="inv-tabs">
            <a asp-controller="Sales" asp-action="Index" class="inv-tab inv-tab--active">Transactions</a>
            <a asp-controller="Sales" asp-action="Customerlist" class="inv-tab">Customer List</a>
        </div>
    </section>

    <!-- TABLE 1: IN PROGRESS JOB ORDERS -->
    <section class="inv-table-wrap">
        <h3 class="table-section-title">Job Orders (In Progress)</h3>
        <div class="mm-card">
            <table class="mm-table" id="jobOrdersTable">
                <thead>
                    <tr>
                        <th>Client</th>
                        <th>Job ID</th>
                        <th>Cost</th>
                        <th>Status</th>
                        <th class="col-actions">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var job in Model.InProgressJobs)
                    {
                        <tr>
                            <td>@job.Client</td>
                            <td>@job.JobID</td>
                            <td>@job.Cost.ToString("C")</td>
                            <td><span class="status status-warn">In Progress</span></td>
                            <td class="inv-actions">
                                <div class="sales-actions">
                                    <!-- View Job Order Button -->
                                    <button type="button" class="icon-btn-table btn-view-job" title="View Job Order"
                                            data-job-id="@job.JobID">
                                        <i class="fa-regular fa-eye"></i>
                                    </button>

                                    <!-- Create Invoice Button -->
                                    <a asp-action="CreateInvoice"
                                       asp-route-jobId="@job.JobID"
                                       class="icon-btn-table btn-create"
                                       title="Create Invoice">
                                        <i class="fa-solid fa-plus"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <!-- Job Orders Pagination -->
    <div class="table-pagination" id="jobOrdersPagination">
        <button class="pg-btn" id="jobOrdersPrev">‹</button>
        <span id="jobOrdersPageIndicator">Page 1</span>
        <button class="pg-btn" id="jobOrdersNext">›</button>
    </div>

    

    <!-- TABLE 2: INVOICES (UNCHANGED) -->
    <section class="inv-table-wrap">
        <h3 class="table-section-title">Invoices</h3>

        <!-- SEARCH + FILTER / EXPORT -->
        <section class="inv-filter-bar">
            <div class="inv-search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input class="inv-search-input" type="text" placeholder="Search by invoice, customer, or job ID..." />
            </div>
            <div class="inv-filter-actions">
                <select id="statusFilter" class="btn-chip">
                    <option value="all">All</option>
                    <option value="paid">Paid</option>
                    <option value="pending">Pending</option>
                </select>

                <button class="btn-chip" id="btnExportPdf">
                    <i class="fa-solid fa-download"></i>
                    <span>Export</span>
                </button>
            </div>
        </section>

        <div class="mm-card">
            <table class="mm-table" id="salesTable">
                <thead>
                    <tr>
                        <th>Invoice ID</th>
                        <th>Client</th>
                        <th>Job ID</th>
                        <th>Amount</th>
                        <th>Payment Type</th>
                        <th>Date Issued</th>
                        <th>Due Date</th>
                        <th>Status</th>
                        <th class="col-actions">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var invoice in Model.Invoices)
                    {
                        <tr>
                            <td>@invoice.InvoiceNumber</td>
                            <td>@invoice.ClientName</td>
                            <td>@invoice.JobID</td>
                            <td>@invoice.Amount.ToString("C")</td>
                            <td>@invoice.PaymentType</td>
                            <td>@invoice.DateIssued.ToString("yyyy-MM-dd")</td>
                            <td>@(invoice.DueDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                            <td>
                                <span class="status @(invoice.Status.ToLower() == "pending" ? "status-pending" :
                                      invoice.Status.ToLower() == "paid" ? "status-paid" :
                                                   "status-warn")">
                                @invoice.Status
                            </span>
                        </td>
                        <td class="inv-actions">
                            <div class="sales-actions">
                                <!-- View Invoice Button -->
                                <button type="button" class="icon-btn-table btn-view" title="View invoice"
                                        data-invoice-id="@invoice.InvoiceID">
                                    <i class="fa-regular fa-eye"></i>
                                </button>

                                    <!-- Receive Payment Button: Only render if invoice is NOT paid -->
                                @if (invoice.Status.ToLower() != "paid")
                                    {
                                        <form asp-action="ReceivePayment"
                                              asp-route-id="@invoice.InvoiceID"
                                              method="post"
                                              class="receive-payment-form"
                                              style="display:inline;">
                                            <button type="submit"
                                                    class="icon-btn-table btn-receive"
                                                    title="Receive payment">
                                                <i class="fa-solid fa-check"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>

                    </tr>
               }
                </tbody>
            </table>
        </div>
    </section>

    <!-- Invoice Pagination -->
    <div class="table-pagination" id="invoicePagination">
        <button class="pg-btn" id="invoicePrev">‹</button>
        <span id="invoicePageIndicator">Page 1</span>
        <button class="pg-btn" id="invoiceNext">›</button>
    </div>

    

    <!-- Invoice Modal (unchanged) -->
    <div id="invoiceModal" class="modal">
        <div class="modal-content">
            <span class="close">&times;</span>
            <div id="invoiceModalBody"></div>
        </div>
    </div>
</div>





@section Scripts {

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>


    <!-- View Modal Pop up -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            const modal = document.getElementById("invoiceModal");
            const modalBody = document.getElementById("invoiceModalBody");
            const closeBtn = modal.querySelector(".close");

            document.querySelectorAll('.btn-view').forEach(button => {
                button.addEventListener('click', function () {
                    const invoiceId = this.dataset.invoiceId;

                    fetch(`/Sales/ViewInvoicePartial/${invoiceId}`)
                        .then(response => response.text())
                        .then(html => {
                            modalBody.innerHTML = html;
                            modal.style.display = "block";
                        });
                });
            });

            closeBtn.onclick = function () {
                modal.style.display = "none";
            };

            window.onclick = function (event) {
                if (event.target === modal) {
                    modal.style.display = "none";
                }
            };

        });
    </script>


    <script>
        // INVOICE PAGINATION WITH SEARCH & FILTER
        document.addEventListener('DOMContentLoaded', function () {
            const table = document.getElementById('salesTable');
            const searchInput = document.querySelector('.inv-search-input');
            const statusFilter = document.getElementById('statusFilter');
            const rowsPerPage = 10;
            let currentPage = 1;
            let currentFilter = 'all';

            function getFilteredRows() {
                const term = (searchInput.value || '').trim().toLowerCase();
                return Array.from(table.querySelectorAll('tbody tr')).filter(row => {
                    const statusEl = row.querySelector('.status');
                    const statusText = statusEl ? statusEl.textContent.trim().toLowerCase() : '';
                    const matchesStatus = currentFilter === 'all' || statusText === currentFilter;

                    const rowText = Array.from(row.querySelectorAll('td'))
                                         .slice(0, 7)
                                         .map(td => td.textContent.toLowerCase())
                                         .join(' ');
                    const matchesSearch = rowText.includes(term);
                    return matchesStatus && matchesSearch;
                });
            }

            function renderTablePage() {
                const filteredRows = getFilteredRows();
                const totalPages = Math.ceil(filteredRows.length / rowsPerPage) || 1;

                table.querySelectorAll('tbody tr').forEach(r => r.style.display = 'none');

                filteredRows.forEach((row, index) => {
                    if (index >= (currentPage - 1) * rowsPerPage &&
                        index < currentPage * rowsPerPage) {
                        row.style.display = '';
                    }
                });

                document.getElementById('invoicePageIndicator').textContent = `Page ${currentPage} of ${totalPages}`;
                document.getElementById('invoicePrev').disabled = currentPage === 1;
                document.getElementById('invoiceNext').disabled = currentPage === totalPages;
            }

            // Pagination buttons
            document.getElementById('invoicePrev').addEventListener('click', function() {
                if (currentPage > 1) {
                    currentPage--;
                    renderTablePage();
                }
            });

            document.getElementById('invoiceNext').addEventListener('click', function() {
                const filteredRows = getFilteredRows();
                const totalPages = Math.ceil(filteredRows.length / rowsPerPage) || 1;
                if (currentPage < totalPages) {
                    currentPage++;
                    renderTablePage();
                }
            });

            // Search input
            searchInput.addEventListener('input', function() {
                currentPage = 1;
                renderTablePage();
            });

            // Dropdown filter
            statusFilter.addEventListener('change', function() {
                currentFilter = this.value;
                currentPage = 1;
                renderTablePage();
            });

            // initial render
            renderTablePage();
        });
    </script>

    <script>
        // EXPORT PDF
        document.getElementById('btnExportPdf').addEventListener('click', async () => {
            const { jsPDF } = window.jspdf;
            const table = document.getElementById('salesTable');
            if (!table) return;

            const rows = table.querySelectorAll('tbody tr');
            rows.forEach(row => row.style.display = ''); // show all

            const tableClone = table.cloneNode(true);
            tableClone.querySelectorAll('thead th.col-actions, tbody td.col-actions').forEach(el => el.remove());

            const hiddenDiv = document.createElement('div');
            hiddenDiv.style.position = 'absolute';
            hiddenDiv.style.left = '-9999px';
            hiddenDiv.appendChild(tableClone);
            document.body.appendChild(hiddenDiv);

            try {
                const pdf = new jsPDF('l', 'pt', 'a4');
                const pageWidth = pdf.internal.pageSize.getWidth();
                const pageHeight = pdf.internal.pageSize.getHeight();
                let yOffset = 20;

                const header = tableClone.querySelector('thead');
                const bodyRows = Array.from(tableClone.querySelectorAll('tbody tr'));

                const headerCanvas = await html2canvas(header, { scale: 2 });
                const headerImg = headerCanvas.toDataURL('image/png');
                const headerWidth = pageWidth - 40;
                const headerHeight = (headerCanvas.height * headerWidth) / headerCanvas.width;
                pdf.addImage(headerImg, 'PNG', 20, yOffset, headerWidth, headerHeight);
                yOffset += headerHeight + 10;

                for (let row of bodyRows) {
                    const rowCanvas = await html2canvas(row, { scale: 2 });
                    const rowImg = rowCanvas.toDataURL('image/png');
                    const rowHeight = (rowCanvas.height * headerWidth) / rowCanvas.width;

                    if (yOffset + rowHeight > pageHeight - 20) {
                        pdf.addPage();
                        yOffset = 20;
                        pdf.addImage(headerImg, 'PNG', 20, yOffset, headerWidth, headerHeight);
                        yOffset += headerHeight + 10;
                    }

                    pdf.addImage(rowImg, 'PNG', 20, yOffset, headerWidth, rowHeight);
                    yOffset += rowHeight + 5;
                }

                pdf.save(`Sales_${new Date().toISOString().slice(0,10)}.pdf`);
            } catch (err) {
                console.error('PDF export failed:', err);
            } finally {
                document.body.removeChild(hiddenDiv);
            }
        });
    </script>

    <script>
        // JOB ORDERS PAGINATION
        document.addEventListener('DOMContentLoaded', function () {
            const jobTable = document.getElementById("jobOrdersTable");
            const jobRows = jobTable.querySelectorAll("tbody tr");
            const jobRowsPerPage = 5;
            let jobCurrentPage = 1;

            function renderJobTablePage() {
                const totalPages = Math.ceil(jobRows.length / jobRowsPerPage);
                jobRows.forEach((row, index) => {
                    row.style.display = (index >= (jobCurrentPage - 1) * jobRowsPerPage &&
                                         index < jobCurrentPage * jobRowsPerPage) ? "" : "none";
                });
                document.getElementById("jobOrdersPageIndicator").textContent =
                    `Page ${jobCurrentPage} of ${totalPages}`;
                document.getElementById("jobOrdersPrev").disabled = jobCurrentPage === 1;
                document.getElementById("jobOrdersNext").disabled = jobCurrentPage === totalPages;
            }

            document.getElementById("jobOrdersPrev").addEventListener("click", function() {
                if (jobCurrentPage > 1) {
                    jobCurrentPage--;
                    renderJobTablePage();
                }
            });

            document.getElementById("jobOrdersNext").addEventListener("click", function() {
                const totalPages = Math.ceil(jobRows.length / jobRowsPerPage);
                if (jobCurrentPage < totalPages) {
                    jobCurrentPage++;
                    renderJobTablePage();
                }
            });

            renderJobTablePage();
        });
    </script>

    <!-- Confirmation Modal Receive Payment-->
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            document.querySelectorAll('.receive-payment-form').forEach(form => {
                form.addEventListener('submit', function (e) {
                    e.preventDefault(); // STOP immediate submit

                    const row = form.closest('tr');
                    const invoiceNo = row?.children[0]?.textContent ?? '';
                    const client = row?.children[1]?.textContent ?? '';
                    const amount = row?.children[3]?.textContent ?? '';

                    Swal.fire({
                        title: 'Receive Payment?',
                        html: `
                            <div style="text-align:left">
                                <p><strong>Invoice:</strong> ${invoiceNo}</p>
                                <p><strong>Client:</strong> ${client}</p>
                                <p><strong>Amount:</strong> ${amount}</p>
                                <hr>
                                <p>This invoice will be marked as <b>PAID</b>.</p>
                            </div>
                        `,
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonText: 'Yes, Receive Payment',
                        cancelButtonText: 'Cancel',
                        confirmButtonColor: '#3085d6',
                        cancelButtonColor: '#6c757d',
                        reverseButtons: true
                    }).then((result) => {
                        if (result.isConfirmed) {
                            form.submit(); // ✅ REAL submit only here
                        }
                    });
                });
            });

        });
    </script>


    <!--View Job Order Table-->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const modal = document.getElementById("invoiceModal");
            const modalBody = document.getElementById("invoiceModalBody");

            document.querySelectorAll('.btn-view-job').forEach(button => {
                button.addEventListener('click', function () {
                    const jobId = this.dataset.jobId;

                    fetch(`/Sales/ViewJobOrderPartial/${jobId}`)
                        .then(response => response.text())
                        .then(html => {
                            modalBody.innerHTML = html;
                            modal.style.display = "block";
                        });
                });
            });
        });
    </script>

    <!-- Confirmation Modal Create Invoice -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            // Select all create invoice buttons
            document.querySelectorAll('.btn-create').forEach(button => {
                button.addEventListener('click', function (e) {
                    e.preventDefault(); // prevent default link navigation

                    const row = this.closest('tr'); // get the table row
                    const jobId = row?.children[1]?.textContent.trim() || ''; // Job ID column
                    const client = row?.children[0]?.textContent.trim() || ''; // Client column
                    const cost = row?.children[2]?.textContent.trim() || ''; // Cost column
                    const url = this.href;

                    Swal.fire({
                        title: 'Create Invoice?',
                        html: `
                            <div style="text-align:left">
                                <p><strong>Client:</strong> ${client}</p>
                                <p><strong>Job ID:</strong> ${jobId}</p>
                                <p><strong>Cost:</strong> ${cost}</p>
                                <hr>
                                <p>This will create a new invoice for this job.</p>
                            </div>
                        `,
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonText: 'Yes, Create Invoice',
                        cancelButtonText: 'Cancel',
                        confirmButtonColor: '#3085d6',
                        cancelButtonColor: '#6c757d',
                        reverseButtons: true
                    }).then((result) => {
                        if (result.isConfirmed) {
                            window.location.href = url; // redirect to create invoice action
                        }
                    });
                });
            });

        });
    </script>




}

