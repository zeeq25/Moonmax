                                    <i class="fa-solid fa-xmark"></i>
                                </button>
                                <button type="button"
                                        class="icon-btn-table btn-delete"
                                        title="Delete invoice">
                                    <i class="fa-regular fa-trash-can"></i>
                                </button>
                            </div>
                        </td>
