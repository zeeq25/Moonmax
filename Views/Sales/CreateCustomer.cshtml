@model Moonmax.ViewModels.CustomerFormViewModel

@{
    ViewData["Title"] = "Add Customer";
    ViewData["Nav"] = "Sales";
    ViewData["AppShell"] = true;
}
@section Styles {
    <link rel="stylesheet" href="~/css/tophead.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/sales.css" asp-append-version="true" />
}


<div class="page page-sales">
    <header class="dash-header">
        <h1 class="dash-title">Add Customer</h1>
        <a asp-action="CustomerList" class="btn-pill btn-secondary-mm">
            <i class="fa-solid fa-arrow-left"></i> Back
        </a>
    </header>

    <div class="mm-card">
        <form asp-action="CreateCustomer" method="post">
            <div class="form-group">
                <label>Name</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Email</label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Phone</label>
                <input asp-for="Phone" class="form-control" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Payment Type</label>
                <select asp-for="PaymentType" class="form-control" asp-items="@(new SelectList(ViewBag.PaymentTypes))">
                    <option value="">-- Select Payment Type --</option>
                </select>
                <span asp-validation-for="PaymentType" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Customer Type</label>
                <select asp-for="ClientType" class="form-control">
                    <option value="MainClient">Main Client</option>
                    <option value="Walk-In">Walk-In</option>
                </select>
                <span asp-validation-for="ClientType" class="text-danger"></span>
            </div>


            <button type="submit" class="btn-pill btn-primary-mm">Add Customer</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
