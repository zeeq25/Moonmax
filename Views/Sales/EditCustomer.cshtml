@model Moonmax.ViewModels.CustomerFormViewModel



@{
    ViewData["Title"] = "Edit Customer";
    ViewData["Nav"] = "Sales";
    ViewData["AppShell"] = true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/tophead.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/sales.css" asp-append-version="true" />
}

<div class="mm-card p-4">
    <h2>Edit Customer</h2>
    <form asp-action="EditCustomer" method="post">
        <input type="hidden" asp-for="ClientID" />

        <div class="mb-3">
            <label class="form-label">Name</label>
            <input asp-for="Name" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Email</label>
            <input asp-for="Email" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Phone</label>
            <input asp-for="Phone" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Payment Type</label>
            <select asp-for="PaymentType" class="form-control" asp-items="new SelectList(ViewBag.PaymentTypes)"></select>
        </div>

        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a asp-action="CustomerList" class="btn btn-secondary">Cancel</a>
    </form>
</div>
