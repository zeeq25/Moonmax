@model IEnumerable<Moonmax.ViewModels.CustomerViewModel>

@{
    ViewData["Title"] = "Customer List";
    ViewData["Nav"] = "Sales";
    ViewData["AppShell"] = true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/tophead.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/sales.css" asp-append-version="true" />
}

<div class="page page-sales">

    <!-- PAGE HEADER -->
    <header class="dash-header">
        <div>
            <h1 class="dash-title">Sales &amp; Billing</h1>
            <p class="dash-sub">Manage customer transactions and invoices</p>
        </div>

        <div class="dash-actions">
            <a asp-action="CreateCustomer"
               class="btn-pill btn-primary-mm">
                <i class="fa-solid fa-plus"></i>
                <span>Add Customer</span>
            </a>
        </div>
    </header>

    <!-- KPI CARDS -->
    <section class="dash-kpis">
        <article class="dash-card kpi">
            <div class="kpi-icon"><i class="fa-solid fa-receipt"></i></div>
            <div class="kpi-content">
                <div class="kpi-title">Total Value</div>
                <div class="kpi-main">
                    @Model.Sum(c => c.TotalRevenue + c.Outstanding).ToString("C", new System.Globalization.CultureInfo("en-PH"))
                </div>
            </div>
        </article>

        <article class="dash-card kpi">
            <div class="kpi-icon"><i class="fa-solid fa-money-bill-1-wave"></i></div>
            <div class="kpi-content">
                <div class="kpi-title">Paid Invoices</div>
                <div class="kpi-main">
                    @Model.Sum(c => c.TotalRevenue).ToString("C", new System.Globalization.CultureInfo("en-PH"))
                </div>
            </div>
        </article>


        <article class="dash-card kpi">
            <div class="kpi-icon"><i class="fa-solid fa-file-invoice-dollar"></i></div>
            <div class="kpi-content">
                <div class="kpi-title">Pending PDCs</div>
                <div class="kpi-main">
                    @Model.Sum(c => c.Outstanding).ToString("C", new System.Globalization.CultureInfo("en-PH"))
                </div>
            </div>
        </article>

        <article class="dash-card kpi">
            <div class="kpi-icon"><i class="fa-solid fa-user-group"></i></div>
            <div class="kpi-content">
                <div class="kpi-title">Total Customers</div>
                <div class="kpi-main">@Model.Count()</div>
            </div>
        </article>

    </section>

    <!-- TABS -->
    <section class="inv-tabs-bar">
        <div class="inv-tabs">
            <a asp-controller="Sales" asp-action="Index" class="inv-tab">Transactions</a>
            <a asp-controller="Sales" asp-action="Customerlist" class="inv-tab inv-tab--active">Customer List</a>
        </div>
    </section>

    <!-- SEARCH + FILTER / EXPORT -->
    <section class="inv-filter-bar">
        <div class="inv-search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input class="inv-search-input" type="text" placeholder="Search by customer name, email, phone, or payment type..." />
        </div>

        <div class="inv-filter-actions">
            <button class="btn-chip"><i class="fa-solid fa-filter"></i><span>Filter</span></button>
            <button class="btn-chip"><i class="fa-solid fa-download"></i><span>Export</span></button>
        </div>
    </section>

    <!-- TABLE: CUSTOMER LIST -->
    <section class="inv-table-wrap">
        <div class="mm-card">
            <table class="mm-table" id="custlistTable">
                <thead>
                    <tr>
                        <th>Customer Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Payment Type</th>
                        <th>Total Transactions</th>
                        <th>Total Revenue</th>
                        <th>Outstanding</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var client in Model)
                    {
                        <tr>
                            <td>@client.Name</td>
                            <td>@client.Email</td>
                            <td>@client.Phone</td>
                            <td>@client.PaymentType</td>
                            <td>@client.TotalTransactions</td>
                            <td>@client.TotalRevenue.ToString("C", new System.Globalization.CultureInfo("en-PH"))</td>
                            <td>
                                <span class="badge @(client.Outstanding == 0 ? "status-ok" : "status-low")">
                                    @client.Outstanding.ToString("C", new System.Globalization.CultureInfo("en-PH"))
                                </span>
                            </td>

                            <td>
                                <a asp-action="EditCustomer"
                                   asp-route-id="@client.ClientID"
                                   class="btn btn-sm btn-warning">
                                    <i class="fa-solid fa-pen"></i> Edit
                                </a>
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <!-- PAGINATION -->
    <div class="table-pagination">
        <button class="pg-btn" onclick="changePage(-1)">‹</button>
        <span id="pageIndicator">Page 1</span>
        <button class="pg-btn" onclick="changePage(1)">›</button>
    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.querySelector('.page-sales .inv-search-input');
            const table = document.querySelector('.page-sales .mm-table');

            if (!searchInput || !table) return;

            const rows = table.querySelectorAll('tbody tr');

            searchInput.addEventListener('input', function () {
                const query = this.value.trim().toLowerCase();

                rows.forEach(row => {
                    const text = row.textContent.toLowerCase();
                    row.style.display = text.includes(query) ? '' : 'none';
                });
            });
        });

        // Pagination
        const rowsPerPage = 10;
        let currentPage = 1;

        function renderTablePage() {
            const table = document.getElementById("custlistTable");
            const rows = table.querySelectorAll("tbody tr");
            const totalPages = Math.ceil(rows.length / rowsPerPage);

            rows.forEach((row, index) => {
                row.style.display =
                    index >= (currentPage - 1) * rowsPerPage &&
                    index < currentPage * rowsPerPage
                        ? ""
                        : "none";
            });

            document.getElementById("pageIndicator").textContent =
                `Page ${currentPage} of ${totalPages}`;
            document.querySelectorAll(".pg-btn")[0].disabled = currentPage === 1;
            document.querySelectorAll(".pg-btn")[1].disabled = currentPage === totalPages;
        }

        function changePage(step) {
            const table = document.getElementById("custlistTable");
            const rows = table.querySelectorAll("tbody tr");
            const totalPages = Math.ceil(rows.length / rowsPerPage);

            currentPage += step;
            if (currentPage < 1) currentPage = 1;
            if (currentPage > totalPages) currentPage = totalPages;

            renderTablePage();
        }

        renderTablePage();
    </script>
}
