@model Moonmax.ViewModels.ReceiptViewModel

<div class="receipt-print-area" style="background:white; padding:32px 40px; max-width:800px; margin:0 auto; font-size:13px;">

    <!-- Header Row -->
    <div style="display:grid; grid-template-columns:1fr auto; gap:20px; margin-bottom:24px; padding-bottom:20px; border-bottom:2px solid #18181b;">
        <div>
            <h1 style="color:#18181b; margin:0 0 4px 0; font-size:24px; font-weight:700; letter-spacing:-0.5px;">OFFICIAL RECEIPT</h1>
            <p style="margin:0; font-size:13px; color:#71717a; font-weight:500;">Moonmax Company</p>
            <p style="margin:2px 0 0 0; font-size:11px; color:#a1a1aa;">123 Business St, Davao City • (+63) 912-345-6789</p>
        </div>
        <div style="text-align:right;">
            <p style="margin:0 0 2px 0; font-size:10px; color:#a1a1aa; text-transform:uppercase; letter-spacing:0.5px;">Receipt No.</p>
            <p style="margin:0; font-size:18px; color:#18181b; font-weight:700; font-family:monospace;">RCT-@Model.InvoiceNumber</p>
        </div>
    </div>

    <!-- Info Grid - 3 Columns -->
    <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:16px 24px; margin-bottom:20px;">

        <div>
            <p style="margin:0 0 3px 0; font-size:10px; color:#a1a1aa; text-transform:uppercase; letter-spacing:0.5px;">Invoice Number</p>
            <p style="margin:0; font-size:13px; color:#18181b; font-weight:600;">@Model.InvoiceNumber</p>
        </div>

        <div>
            <p style="margin:0 0 3px 0; font-size:10px; color:#a1a1aa; text-transform:uppercase; letter-spacing:0.5px;">Job ID</p>
            <p style="margin:0; font-size:13px; color:#18181b; font-weight:600;">@Model.JobID</p>
        </div>

        <div>
            <p style="margin:0 0 3px 0; font-size:10px; color:#a1a1aa; text-transform:uppercase; letter-spacing:0.5px;">Date Issued</p>
            <p style="margin:0; font-size:13px; color:#18181b; font-weight:600;">@DateTime.Now.ToString("MMM dd, yyyy")</p>
        </div>

        <div style="grid-column: span 2;">
            <p style="margin:0 0 3px 0; font-size:10px; color:#a1a1aa; text-transform:uppercase; letter-spacing:0.5px;">Received From</p>
            <p style="margin:0; font-size:13px; color:#18181b; font-weight:600;">@Model.ClientName</p>
        </div>

        <div>
            <p style="margin:0 0 3px 0; font-size:10px; color:#a1a1aa; text-transform:uppercase; letter-spacing:0.5px;">Payment Date</p>
            <p style="margin:0; font-size:13px; color:#18181b; font-weight:600;">@Model.PaymentDate.ToString("MMM dd, yyyy")</p>
        </div>

    </div>

    <!-- Payment Summary Box -->
    <div style="background:#f4f4f5; padding:16px 20px; border-radius:8px; margin-bottom:16px; border-left:4px solid #18181b;">
        <div style="display:grid; grid-template-columns:1fr auto; gap:12px; align-items:center;">
            <div>
                <p style="margin:0 0 2px 0; font-size:11px; color:#71717a; text-transform:uppercase; letter-spacing:0.5px;">Payment For</p>
                <p style="margin:0; font-size:13px; color:#18181b; font-weight:500;">Invoice @Model.InvoiceNumber - @Model.PaymentMethod</p>
            </div>
            <div style="text-align:right;">
                <p style="margin:0 0 2px 0; font-size:11px; color:#71717a; text-transform:uppercase; letter-spacing:0.5px;">Amount Paid</p>
                <p style="margin:0; font-size:22px; color:#18181b; font-weight:700; letter-spacing:-0.5px;">₱@Model.AmountPaid.ToString("N2")</p>
            </div>
        </div>
    </div>

    <!-- Payment Method Details (Compact Horizontal) -->
    <div style="margin-bottom:16px; padding:14px 20px; background:#fafafa; border-radius:6px;">
        <p style="margin:0 0 8px 0; font-size:10px; color:#71717a; text-transform:uppercase; letter-spacing:0.5px; font-weight:600;">Payment Details</p>

        <div style="display:grid; grid-template-columns:repeat(2, 1fr); gap:8px 24px;">
            @if (!string.IsNullOrEmpty(Model.CheckNumber))
            {
                <div style="display:flex; justify-content:space-between;">
                    <span style="font-size:12px; color:#71717a;">Check No:</span>
                    <span style="font-size:12px; color:#18181b; font-weight:600; font-family:monospace;">@Model.CheckNumber</span>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.BankName))
            {
                <div style="display:flex; justify-content:space-between;">
                    <span style="font-size:12px; color:#71717a;">Bank:</span>
                    <span style="font-size:12px; color:#18181b; font-weight:600;">@Model.BankName</span>
                </div>
            }

            @if (Model.CheckDate.HasValue)
            {
                <div style="display:flex; justify-content:space-between;">
                    <span style="font-size:12px; color:#71717a;">Check Date:</span>
                    <span style="font-size:12px; color:#18181b; font-weight:600;">@Model.CheckDate.Value.ToString("MMM dd, yyyy")</span>
                </div>
            }

            <!-- ✅ ALWAYS SHOW REFERENCE NUMBER -->
            <div style="display:flex; justify-content:space-between;">
                <span style="font-size:12px; color:#71717a;">Ref No:</span>
                <span style="font-size:12px; color:#18181b; font-weight:600; font-family:monospace;">@(Model.ReferenceNumber ?? "—")</span>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <div style="padding-top:16px; border-top:1px solid #e4e4e7; text-align:center;">
        <p style="margin:0 0 4px 0; font-size:12px; color:#52525b; font-weight:500;">Thank you for your business!</p>
        <p style="margin:0; font-size:11px; color:#a1a1aa;">This is an official receipt. Please keep for your records.</p>
    </div>
</div>