@model Moonmax.ViewModels.CreatePurchaseOrderViewModel

@{
    ViewData["Title"] = "Create Purchase Order";
    ViewData["Nav"] = "Procurement";
    ViewData["AppShell"] = true;
}


@section Styles {
    <link rel="stylesheet" href="~/css/tophead.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/procurement.css" asp-append-version="true" />
}

<div class="container mt-4">

    <h1>Create Purchase Order</h1>
    <hr />

    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">

            <form asp-action="CreatePurchaseOrder"
                  asp-controller="Procurement"
                  method="post"
                  class="p-4 border rounded-3 bg-white">

                @Html.AntiForgeryToken()

                <!-- Back Button -->
                <div class="mb-3">
                    <a asp-action="Index"
                       asp-controller="Procurement"
                       class="btn btn-outline-secondary">
                        <i class="fa-solid fa-arrow-left"></i> Back
                    </a>
                </div>

                <!-- Supplier -->
                <div class="mb-4">
                    <label class="form-label">Supplier</label>
                    <select asp-for="SupplierID"
                            class="form-control"
                            asp-items="@(new SelectList(Model.Suppliers, "SupplierID", "SupplierName"))">
                        <option value="">-- Select Supplier --</option>
                    </select>
                    <span asp-validation-for="SupplierID" class="text-danger"></span>
                </div>

                <!-- Items -->
                <div id="po-items" class="mb-3">
                    <h4 class="mb-2">Items</h4>

                    @{
                        var categories = new[] { "Hoses", "Fittings", "Lubricants", "Tools", "Supplies", "Others" };
                    }

                    @if (Model.Items != null && Model.Items.Any())
                    {
                        for (int i = 0; i < Model.Items.Count; i++)
                        {
                            <div class="po-item d-flex align-items-center gap-2 mb-2">
                                <input type="text"
                                       name="Items[@i].ProductName"
                                       value="@Model.Items[i].ProductName"
                                       placeholder="Product Name"
                                       class="form-control" />

                                <input type="number"
                                       name="Items[@i].Quantity"
                                       value="@Model.Items[i].Quantity"
                                       placeholder="Qty"
                                       class="form-control" />

                                <input type="number"
                                       step="0.01"
                                       name="Items[@i].UnitPrice"
                                       value="@Model.Items[i].UnitPrice"
                                       placeholder="Unit Price"
                                       class="form-control" />

                                <select asp-for="Items[i].Category"
                                        class="form-control"
                                        asp-items="@(new SelectList(Model.Categories, Model.Items[i].Category))">
                                    <option value="">Category</option>
                                </select>

                                <button type="button"
                                        class="btn btn-danger btn-sm remove-item">
                                    Remove
                                </button>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="po-item d-flex align-items-center gap-2 mb-2">
                            <input type="text"
                                   name="Items[0].ProductName"
                                   placeholder="Product Name"
                                   class="form-control" />

                            <input type="number"
                                   name="Items[0].Quantity"
                                   placeholder="Qty"
                                   class="form-control" />

                            <input type="number"
                                   step="0.01"
                                   name="Items[0].UnitPrice"
                                   placeholder="Unit Price"
                                   class="form-control" />

                            <select name="Items[0].Category" class="form-control">
                                <option value="">Category</option>
                                @foreach (var cat in categories)
                                {
                                    <option value="@cat">@cat</option>
                                }
                            </select>

                            <button type="button"
                                    class="btn btn-danger btn-sm remove-item">
                                Remove
                            </button>
                        </div>
                    }
                </div>

                <button type="button"
                        id="add-item"
                        class="btn btn-secondary mb-4">
                    Add Another Item
                </button>

                <!-- Expected Delivery -->
                <div class="mb-4">
                    <label class="form-label">Expected Delivery</label>
                    <input asp-for="ExpectedDelivery"
                           type="date"
                           class="form-control" />
                    <span asp-validation-for="ExpectedDelivery" class="text-danger"></span>
                </div>

                <!-- Submit -->
                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary">
                        Create Purchase Order
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        let itemIndex = @Model.Items?.Count ?? 1;
        const categories = ["Hoses", "Fittings", "Lubricants", "Tools", "Supplies", "Others"];

        // Add new item dynamically
        document.getElementById('add-item').addEventListener('click', () => {
            const container = document.getElementById('po-items');
            const div = document.createElement('div');
            div.className = 'po-item d-flex align-items-center mb-1';

            let optionsHtml = `<option value="">-- Select Category --</option>`;
            categories.forEach(cat => {
                optionsHtml += `<option value="${cat}">${cat}</option>`;
            });

            div.innerHTML = `
                <input type="text" name="Items[${itemIndex}].ProductName" placeholder="Product Name" class="form-control me-1" />
                <input type="number" name="Items[${itemIndex}].Quantity" placeholder="Quantity" class="form-control me-1" />
                <input type="number" step="0.01" name="Items[${itemIndex}].UnitPrice" placeholder="Unit Price" class="form-control me-1" />
                <select name="Items[${itemIndex}].Category" class="form-control me-1">
                    ${optionsHtml}
                </select>
                <button type="button" class="btn btn-danger btn-sm remove-item">Remove</button>
            `;

            container.appendChild(div);
            itemIndex++;
        });

        // Remove item, ensure at least one remains
        document.getElementById('po-items').addEventListener('click', (e) => {
            if (e.target && e.target.classList.contains('remove-item')) {
                const container = document.getElementById('po-items');
                const itemDiv = e.target.closest('.po-item');
                if (container.querySelectorAll('.po-item').length > 1) {
                    itemDiv.remove();
                } else {
                    Swal.fire({
                        icon: "warning",
                        title: "Action Not Allowed",
                        text: "A Purchase Order must have at least 1 item.",
                        confirmButtonColor: "#3085d6"
                    });
                }
            }
        });

                // AUTO-FILL UNIT PRICE
        document.getElementById('po-items').addEventListener('input', async (e) => {
            if (e.target && e.target.name.includes("ProductName")) {
                const productName = e.target.value;

                // Find UnitPrice input beside this ProductName
                const parent = e.target.closest('.po-item');
                const priceInput = parent.querySelector('input[name*="UnitPrice"]');

                if (productName.trim() === "") {
                    priceInput.value = "";
                    return;
                }

                // Fetch price from controller
                const resp = await fetch(`/Procurement/GetUnitPrice?productName=${encodeURIComponent(productName)}`);
                const data = await resp.json();

                if (data.price > 0) {
                    priceInput.value = data.price;
                }
            }
        });

    </script>
}
