@model Moonmax.ViewModels.CreateSupplierViewModel

@{
    ViewData["Title"] = "Add Supplier";
    ViewData["Nav"] = "Procurement";
    ViewData["AppShell"] = true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/tophead.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/procurement.css" asp-append-version="true" />
}

<div class="container mt-4">

    <h1>Add Supplier</h1>
    <hr />

    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">

            <form asp-action="CreateSupplier"
                  asp-controller="Procurement"
                  method="post"
                  class="p-4 border rounded-3 bg-white">

                @Html.AntiForgeryToken()

                <!-- Back Button -->
                <div class="mb-3">
                    <a asp-action="Suppliers" class="btn btn-outline-secondary">
                        <i class="fa-solid fa-arrow-left"></i> Back
                    </a>
                </div>

                <!-- Supplier Name -->
                <div class="mb-3">
                    <label asp-for="SupplierName" class="form-label"></label>
                    <input asp-for="SupplierName"
                           class="form-control"
                           placeholder="Enter supplier name" />
                    <span asp-validation-for="SupplierName" class="text-danger"></span>
                </div>

                <!-- Contact Number -->
                <div class="mb-3">
                    <label asp-for="ContactNumber" class="form-label"></label>
                    <input asp-for="ContactNumber"
                           class="form-control"
                           placeholder="Enter contact number" />
                    <span asp-validation-for="ContactNumber" class="text-danger"></span>
                </div>

                <!-- Email -->
                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email"
                           class="form-control"
                           placeholder="Enter email address" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <!-- Product Line -->
                <div class="mb-3">
                    <label asp-for="ProductLine" class="form-label"></label>
                    <input asp-for="ProductLine"
                           class="form-control"
                           placeholder="Enter product line" />
                    <span asp-validation-for="ProductLine" class="text-danger"></span>
                </div>

                <!-- Payment Terms -->
                <div class="mb-3">
                    <label asp-for="PaymentTerms" class="form-label"></label>
                    <select asp-for="PaymentTerms" class="form-control">
                        <option value="Cash On Delivery">COD</option>
                        <option value="PDC(15 Days)">PDC-15</option>
                        <option value="PDC(30 Days)">PDC-30</option>
                        <option value="PDC(60 Days)">PDC-60</option>
                    </select>
                    <span asp-validation-for="PaymentTerms" class="text-danger"></span>
                </div>

                <!-- Status -->
                <div class="mb-4">
                    <label asp-for="Status" class="form-label"></label>
                    <select asp-for="Status" class="form-control">
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                    </select>
                </div>

                <!-- Submit -->
                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary">
                        <i class="fa-solid fa-plus"></i> Add Supplier
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
