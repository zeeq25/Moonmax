@model IEnumerable<Moonmax.ViewModels.SupplierViewModel>


@{
    ViewData["Title"] = "Suppliers";
    ViewData["Nav"] = "Procurement";
    ViewData["AppShell"] = true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/tophead.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/procurement.css" asp-append-version="true" />
}

<div class="page page-proc">

    <!-- HEADER -->
    <header class="dash-header">
        <div>
            <h1 class="dash-title">Suppliers</h1>
            <p class="dash-sub">Manage all vendors and partners.</p>
        </div>

        <div class="dash-actions">
            <a asp-controller="Procurement" asp-action="CreateSupplier"
               class="btn-pill btn-primary-mm">
                <i class="fa-solid fa-user-plus"></i>
                <span>Add Supplier</span>
            </a>
        </div>
    </header>

    <!-- KPI CARDS -->
    <section class="dash-kpis">
        <article class="dash-card kpi">
            <div class="kpi-icon">
                <i class="fa-solid fa-building-user"></i>
            </div>
            <div>
                <div class="kpi-title">Active Suppliers</div>
                <div class="kpi-main">@Model.Count(s => s.Status == "Active")</div>
            </div>
        </article>

        <article class="dash-card kpi">
            <div class="kpi-icon">
                <i class="fa-regular fa-clipboard"></i>
            </div>
            <div>
                <div class="kpi-title">Pending POs</div>
                <div class="kpi-main">0</div>
            </div>
        </article>

        <article class="dash-card kpi">
            <div class="kpi-icon">
                <i class="fa-solid fa-truck-moving"></i>
            </div>
            <div>
                <div class="kpi-title">Delivered POs</div>
                <div class="kpi-main">0</div>
            </div>
        </article>

        <article class="dash-card kpi">
            <div class="kpi-icon">
                <i class="fa-solid fa-peso-sign"></i>
            </div>
            <div>
                <div class="kpi-title">Total PO Value</div>
                <div class="kpi-main">₱0</div>
            </div>
        </article>
    </section>

    <!-- SEARCH + TABS -->
    <section class="proc-toolbar">
        <div class="proc-toolbar-row">
            <div class="proc-search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" class="proc-search-input"
                       placeholder="Search suppliers..." />
            </div>

            <div class="proc-tabs-row">
                <a asp-controller="Procurement" asp-action="Index"
                   class="proc-tab">Purchase Orders</a>
                <a asp-controller="Procurement" asp-action="Suppliers"
                   class="proc-tab proc-tab--active">Suppliers</a>              
            </div>
        </div>
    </section>

    <!-- SUPPLIERS TABLE -->
    <section class="proc-table-wrap">
        <div class="mm-card">
            <table class="mm-table" id="supplierTable">
                <thead>
                    <tr>
                        <th>Supplier Name</th>
                        <th>Contact Number</th>
                        <th>Email</th>
                        <th>Product Line</th>
                        <th>Payment Terms</th>
                        <th>Status</th>
                        <th class="proc-col-actions">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td>@s.SupplierName</td>
                            <td>@s.ContactNumber</td>
                            <td>@s.Email</td>
                            <td>@s.ProductLine</td>
                            <td>@s.PaymentTermsDisplay</td>

                            <td>
                                @if (s.Status == "Active")
                                {
                                    <span class="badge status-active">Active</span>
                                }
                                else
                                {
                                    <span class="badge status-inactive">Inactive</span>
                                }
                            </td>

                            <td class="proc-col-actions">
                                <div class="proc-actions">
                                    <a asp-action="EditSupplier" asp-route-id="@s.SupplierID"
                                       class="icon-btn-table btn-edit" title="Edit">
                                        <i class="fa-regular fa-pen-to-square"></i>
                                    </a>

                                    @if (s.Status == "Active")
                                    {
                                        <form asp-action="DeactivateSupplier" asp-route-id="@s.SupplierID"
                                              method="post" style="display:inline;">
                                            <button type="submit" class="icon-btn-table btn-delete" title="Deactivate">
                                                <i class="fa-solid fa-user-slash"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="ActivateSupplier" asp-route-id="@s.SupplierID"
                                              method="post" style="display:inline;">
                                            <button type="submit" class="icon-btn-table btn-activate" title="Activate">
                                                <i class="fa-solid fa-user-check"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <!-- PAGINATION -->
    <div class="table-pagination">
        <button class="pg-btn" onclick="changePage(-1)">‹</button>
        <span id="pageIndicator">Page 1</span>
        <button class="pg-btn" onclick="changePage(1)">›</button>
    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.querySelector('.proc-search-input');
            const rows = document.querySelectorAll('.mm-table tbody tr');

            if (!searchInput) return;

            function applySearch() {
                const term = (searchInput.value || '').trim().toLowerCase();

                rows.forEach(row => {
                    const text = row.innerText.toLowerCase();
                    row.style.display = term === '' || text.includes(term)
                        ? ''
                        : 'none';
                });
            }

            searchInput.addEventListener('input', applySearch);
        });

        // Pagination
        const rowsPerPage = 10;
        let currentPage = 1;

        function renderTablePage() {
            const table = document.getElementById("supplierTable");
            const rows = table.querySelectorAll("tbody tr");
            const totalPages = Math.ceil(rows.length / rowsPerPage);

            rows.forEach((row, index) => {
                row.style.display =
                    index >= (currentPage - 1) * rowsPerPage &&
                    index < currentPage * rowsPerPage
                        ? ""
                        : "none";
            });

            document.getElementById("pageIndicator").textContent =
                `Page ${currentPage} of ${totalPages}`;
            document.querySelectorAll(".pg-btn")[0].disabled = currentPage === 1;
            document.querySelectorAll(".pg-btn")[1].disabled = currentPage === totalPages;
        }

        function changePage(step) {
            const table = document.getElementById("supplierTable");
            const rows = table.querySelectorAll("tbody tr");
            const totalPages = Math.ceil(rows.length / rowsPerPage);

            currentPage += step;
            if (currentPage < 1) currentPage = 1;
            if (currentPage > totalPages) currentPage = totalPages;

            renderTablePage();
        }

        renderTablePage();
    </script>
}
