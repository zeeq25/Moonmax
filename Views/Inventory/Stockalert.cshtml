@model List<Moonmax.ViewModels.InventoryListingVM>

@{
    ViewData["Title"] = "Inventory Stock Alerts";
    ViewData["Nav"] = "Inventory";
    ViewData["AppShell"] = true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/tophead.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/inventory.css" asp-append-version="true" />
}

<div class="page page-inventory">

    <!-- PAGE HEADER -->
    <header class="dash-header">
        <div>
            <h1 class="dash-title">Inventory Management</h1>
            <p class="dash-sub">Monitor critical and low-stock items</p>
        </div>
    </header>

    <!-- KPI CARDS -->
    <section class="dash-kpis">
        <article class="dash-card kpi">
            <div class="kpi-icon">
                <i class="fa-solid fa-box-archive"></i>
            </div>
            <div class="kpi-content">
                <div class="kpi-title">Total Low-Stock Items</div>
                <div class="kpi-main">@Model.Count</div>
            </div>
        </article>
        <article class="dash-card kpi">
            <div class="kpi-icon">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
            <div class="kpi-content">
                <div class="kpi-title">Low Stock Items</div>
                <div class="kpi-main">@Model.Count(i => i.QuantityInStock <= 10)</div>
            </div>
        </article>

        <article class="dash-card kpi">
            <div class="kpi-icon">
                <i class="fa-solid fa-peso-sign"></i>
            </div>
            <div class="kpi-content">
                <div class="kpi-title">Total Value</div>
                <div class="kpi-main">₱@Model.Sum(i => i.UnitCost * i.QuantityInStock)</div>
            </div>
        </article>

        <article class="dash-card kpi">
            <div class="kpi-icon">
                <i class="fa-solid fa-layer-group"></i>
            </div>
            <div class="kpi-content">
                <div class="kpi-title">Categories</div>
                <div class="kpi-main">@Model.Select(i => i.Category).Distinct().Count()</div>
            </div>
        </article>
    </section>

    <!-- TABS -->
    <section class="inv-tabs-bar">
        <div class="inv-tabs">
            <a asp-controller="Inventory"
               asp-action="Index"
               class="inv-tab">
                Products
            </a>

            <a asp-controller="Inventory"
               asp-action="Stockalert"
               class="inv-tab inv-tab--active">
                Stock Alerts
            </a>
        </div>
    </section>

    <!-- SEARCH + FILTER / EXPORT -->
    <section class="inv-filter-bar">
        <div class="inv-search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input class="inv-search-input"
                   type="text"
                   placeholder="Search low stock items by name, code, category, or supplier..." />
        </div>

        <div class="inv-filter-actions">
            <select id="statusFilter" class="btn-chip">
                <option value="all">All Status</option>
                <option value="low-stock">Low Stock</option>
                <option value="critical">Critical</option>
            </select>
        </div>

    </section>

    <!-- TABLE -->
    <section class="inv-table-wrap">
        <div class="mm-card">
            <table class="mm-table" id="stockAlertTable">
                <thead>
                    <tr>
                        <th>Item Code</th>
                        <th>Item Name</th>
                        <th>Category</th>
                        <th>On Hand</th>
                        <th>Reorder Level</th>
                        <th>Supplier</th>
                        <th>Unit Price</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.InventoryID</td>
                            <td>@item.PartName</td>
                            <td><span class="chip chip-cat">@item.Category</span></td>
                            <td>@item.QuantityInStock</td>
                            <td>@item.ReorderLevel</td>
                            <td>@item.SupplierName</td>
                            <td>₱@item.UnitCost</td>
                            <td>
                                @if (item.QuantityInStock <= item.ReorderLevel / 2)
                                {
                                    <span class="badge status-low">Critical</span>
                                }
                                else
                                {
                                    <span class="badge status-warn">Low Stock</span>
                                }
                            </td>
                            <!--
                            <td class="inv-actions">
                                <a asp-controller="Inventory"
                                   asp-action="Edit"
                                   asp-route-id="@item.InventoryID"
                                   class="inv-btn-icon"
                                   title="Edit">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </a>
                            </td>-->
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <!-- PAGINATION -->
    <div class="table-pagination">
        <button class="pg-btn" onclick="changePage(-1)">‹</button>
        <span id="pageIndicator">Page 1</span>
        <button class="pg-btn" onclick="changePage(1)">›</button>
    </div>


</div>

@section Scripts {
    <script>
               document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.querySelector('.inv-search-input');
            const statusFilter = document.getElementById('statusFilter');
            const table = document.getElementById("stockAlertTable");
            const rows = Array.from(table.querySelectorAll("tbody tr"));

            const rowsPerPage = 10;
            let currentPage = 1;

            function getFilteredRows() {
                const term = (searchInput.value || '').trim().toLowerCase();
                const status = (statusFilter.value || 'all');

                return rows.filter(row => {
                    const cells = row.querySelectorAll('td');
                    const code = cells[0]?.innerText.toLowerCase() || '';
                    const name = cells[1]?.innerText.toLowerCase() || '';
                    const category = cells[2]?.innerText.toLowerCase() || '';
                    const supplier = cells[5]?.innerText.toLowerCase() || '';
                    const rowStatus = cells[7]?.innerText.toLowerCase() || '';

                    const combined = `${code} ${name} ${category} ${supplier}`;
                    const matchesSearch = term === '' || combined.includes(term);

                    const matchesStatus =
                        status === 'all' ||
                        (status === 'low-stock' && rowStatus.includes('low stock')) ||
                        (status === 'critical' && rowStatus.includes('critical'));

                    return matchesSearch && matchesStatus;
                });
            }

            function renderTablePage() {
                const filteredRows = getFilteredRows();
                const totalPages = Math.ceil(filteredRows.length / rowsPerPage) || 1;

                rows.forEach(row => row.style.display = 'none');

                filteredRows.forEach((row, index) => {
                    if (index >= (currentPage - 1) * rowsPerPage &&
                        index < currentPage * rowsPerPage) {
                        row.style.display = '';
                    }
                });

                document.getElementById("pageIndicator").textContent =
                    `Page ${currentPage} of ${totalPages}`;

                document.querySelectorAll(".pg-btn")[0].disabled = currentPage === 1;
                document.querySelectorAll(".pg-btn")[1].disabled = currentPage === totalPages;
            }

            function changePage(step) {
                const filteredRows = getFilteredRows();
                const totalPages = Math.ceil(filteredRows.length / rowsPerPage) || 1;

                currentPage += step;
                if (currentPage < 1) currentPage = 1;
                if (currentPage > totalPages) currentPage = totalPages;

                renderTablePage();
            }

            // Hook up search and filter
            searchInput.addEventListener('input', () => { currentPage = 1; renderTablePage(); });
            statusFilter.addEventListener('change', () => { currentPage = 1; renderTablePage(); });

            // Expose pagination buttons
            window.changePage = changePage;

            // Initial render
            renderTablePage();
        });

    </script>

    <script>
        document.getElementById('btnExportPdf').addEventListener('click', async () => {
            const { jsPDF } = window.jspdf;
            const table = document.getElementById('stockAlertTable');
            if (!table) return;

            const rows = table.querySelectorAll('tbody tr');

            // Store original display and temporarily show all rows
            const originalDisplays = [];
            rows.forEach((row, i) => {
                originalDisplays[i] = row.style.display;
                row.style.display = ''; // show all rows for export
            });

            // Clone the table into a hidden container
            const tableClone = table.cloneNode(true);
            const hiddenDiv = document.createElement('div');
            hiddenDiv.style.position = 'absolute';
            hiddenDiv.style.left = '-9999px';
            hiddenDiv.appendChild(tableClone);
            document.body.appendChild(hiddenDiv);

            try {
                // Capture the cloned table
                const canvas = await html2canvas(tableClone, { scale: 2, useCORS: true });
                const imgData = canvas.toDataURL('image/png');

                const pdf = new jsPDF('l', 'pt', 'a4');
                const pageWidth = pdf.internal.pageSize.getWidth();
                const pageHeight = pdf.internal.pageSize.getHeight();

                const imgProps = pdf.getImageProperties(imgData);
                const pdfWidth = pageWidth - 40;
                const pdfHeight = (imgProps.height * pdfWidth) / imgProps.width;

                pdf.addImage(imgData, 'PNG', 20, 20, pdfWidth, pdfHeight);
                pdf.save(`StockAlert_${new Date().toISOString().slice(0,10)}.pdf`);
            } catch (err) {
                console.error('PDF export failed:', err);
                alert('PDF export failed. Check console for errors.');
            } finally {
                // Restore original display for pagination/search
                rows.forEach((row, i) => row.style.display = originalDisplays[i]);
                document.body.removeChild(hiddenDiv);
                renderTablePage(); // restore pagination
            }
        });
    </script>


}
