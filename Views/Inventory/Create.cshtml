@model Moonmax.ViewModels.InventoryFormVM

@{
    ViewData["Title"] = "Add Inventory";
    ViewData["AppShell"] = true;
}

<div class="container mt-4">
    <h2>Add Inventory</h2>
    <hr />

    <form asp-action="Create" method="post">
        <div class="mb-3">
            <label asp-for="Category" class="form-label"></label>
            <select asp-for="Category" class="form-select" asp-items="Model.Categories">
                <option value="">-- Select Category --</option>
            </select>
            <span asp-validation-for="Category" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="PartName" class="form-label"></label>
            <input asp-for="PartName" class="form-control" />
            <span asp-validation-for="PartName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="UnitCost" class="form-label"></label>
            <input asp-for="UnitCost" class="form-control" />
            <span asp-validation-for="UnitCost" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="QuantityInStock" class="form-label"></label>
            <input asp-for="QuantityInStock" class="form-control" />
            <span asp-validation-for="QuantityInStock" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="SupplierID" class="form-label"></label>
            <select asp-for="SupplierID" class="form-select" asp-items="Model.Suppliers">
                <option value="">-- Select Supplier --</option>
            </select>
            <span asp-validation-for="SupplierID" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Add Inventory</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
