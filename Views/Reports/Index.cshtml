@{
    ViewData["Title"] = "Reports & Analytics";
    ViewData["Nav"] = "Reports";
    ViewData["AppShell"] = true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/tophead.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/reports.css" asp-append-version="true" />
}

<div class="page page-reports">

    <!-- HEADER -->
    <header class="dash-header">
        <div>
            <h1 class="dash-title">Reports &amp; Analytics</h1>
            <p class="dash-sub">Analyze performance, trends and transaction insights</p>
        </div>
    </header>

    <!-- KPIs -->
    <section class="section-block">
        <div class="dash-kpis">
            <!-- Total Revenue -->
            <article class="dash-card kpi">
                <div class="kpi-icon"><i class="fa-solid fa-peso-sign"></i></div>
                <div class="kpi-content">
                    <div class="kpi-title">Total Revenue</div>
                    <div class="kpi-main">₱@(ViewBag.TotalRevenue?.ToString("N2") ?? "0.00")</div>
                </div>
            </article>

            <!-- Avg. Job Value -->
            <article class="dash-card kpi">
                <div class="kpi-icon"><i class="fa-solid fa-briefcase"></i></div>
                <div class="kpi-content">
                    <div class="kpi-title">Avg. Job Value</div>
                    <div class="kpi-main">₱@(ViewBag.AvgJobValue?.ToString("N2") ?? "0.00")</div>
                </div>
            </article>

            <!-- Total Jobs -->
            <article class="dash-card kpi">
                <div class="kpi-icon"><i class="fa-solid fa-list-check"></i></div>
                <div class="kpi-content">
                    <div class="kpi-title">Total Jobs</div>
                    <div class="kpi-main">@((ViewBag.TotalJobs ?? 0).ToString())</div>
                </div>
            </article>

            <!-- Total Inventory Items -->
            <article class="dash-card kpi">
                <div class="kpi-icon"><i class="fa-solid fa-box-archive"></i></div>
                <div class="kpi-content">
                    <div class="kpi-title">Total Inventory Items</div>
                    <div class="kpi-main">@((ViewBag.TotalInventoryItems ?? 0).ToString())</div>
                </div>
            </article>
        </div>
    </section>
    


    <!-- SALES ANALYTICS -->
    <section class="section-block">
        <h2 class="section-title">Sales Analytics</h2>

        <div class="reports-row">
            <article class="mm-card chart-card chart-card--wide">
                <header class="chart-card-header">
                    <h3>Monthly Sales Trend</h3>
                    <p>Revenue trend for the last 6 months.</p>
                </header>
                <div class="chart-card-body"><canvas id="salesTrendChart"></canvas></div>
            </article>

            <article class="mm-card chart-card">
                <header class="chart-card-header">
                    <h3>Service Type Distribution</h3>
                    <p>Job order share per service type.</p>
                </header>
                <div class="chart-card-body chart-card-body--pie">
                    <canvas id="serviceTypeChart"></canvas>
                </div>
            </article>
        </div>
    </section>

    <!-- CLIENT & INVENTORY -->
    <section class="section-block">
        <h2 class="section-title">Clients & Inventory</h2>

        <div class="reports-row">
            <article class="mm-card chart-card">
                <header class="chart-card-header">
                    <h3>Top Clients by Revenue</h3>
                    <p>Highest contributing customers.</p>
                </header>
                <div class="chart-card-body"><canvas id="topClientsChart"></canvas></div>
            </article>

            <article class="mm-card chart-card">
                <header class="chart-card-header">
                    <h3>Inventory Turnover Rate</h3>
                    <p>Stock movement by category.</p>
                </header>
                <div class="chart-card-body"><canvas id="turnoverChart"></canvas></div>
            </article>
        </div>
    </section>
    
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // -------------------------------
        // 1. Convert Razor ViewBag lists to JS arrays safely
        // -------------------------------
        const months = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.Months ?? new List<string>()));
        const monthlyRevenue = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.MonthlyRevenue ?? new List<decimal>()));
        const serviceTypes = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ServiceTypes ?? new List<string>()));
        const serviceRevenue = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ServiceRevenue ?? new List<decimal>()));
        const topClients = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.TopClients ?? new List<string>()));
        const topClientsRevenue = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.TopClientsRevenue ?? new List<decimal>()));
        const turnoverCategories = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.TurnoverCategories ?? new List<string>()));
        const turnoverValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.TurnoverValues ?? new List<decimal>()));

        // -------------------------------
        // 2. Grab CSS variables for colors
        // -------------------------------
        const rootStyles = getComputedStyle(document.documentElement);
        const mmBlue = rootStyles.getPropertyValue('--mm-blue').trim() || '#4F46E5';
        const mmYellow = rootStyles.getPropertyValue('--mm-yellow').trim() || '#FACC15';
        const mmGreen = rootStyles.getPropertyValue('--mm-green').trim() || '#10B981';
        const mmRed = rootStyles.getPropertyValue('--mm-red').trim() || '#EF4444';
        const mmDark = rootStyles.getPropertyValue('--mm-dark').trim() || '#1F2937';

        // -------------------------------
        // 3. Helper to generate array of colors dynamically
        // -------------------------------
        function generateColors(length) {
            const palette = [mmBlue, mmYellow, mmGreen, mmRed, mmDark, '#8B5CF6', '#F472B6', '#10B981'];
            let colors = [];
            for (let i = 0; i < length; i++) {
                colors.push(palette[i % palette.length]);
            }
            return colors;
        }

        // -------------------------------
        // 4. Safe chart creation helper
        // -------------------------------
        function safeCreateChart(ctxId, type, labels, data, extraOptions = {}) {
            const canvas = document.getElementById(ctxId);
            if (!labels || !data || labels.length === 0 || data.length === 0) {
                // Clear canvas and show "No data available"
                if (canvas) {
                    const ctx = canvas.getContext('2d');
                    ctx.clearRect(0, 0, canvas.width, canvas.height);
                    ctx.font = "16px sans-serif";
                    ctx.fillStyle = "#888";
                    ctx.textAlign = "center";
                    ctx.fillText("No data available", canvas.width / 2, canvas.height / 2);
                }
                return null;
            }

            return new Chart(canvas, {
                type: type,
                data: {
                    labels: labels,
                    datasets: [{
                        data: data,
                        backgroundColor: generateColors(labels.length),
                        borderColor: '#ffffff',
                        borderWidth: 1,
                        ...extraOptions.datasetOptions
                    }]
                },
                options: Object.assign({
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: type !== 'line' } },
                    scales: type === 'line' || type === 'bar' ? { y: { beginAtZero: true } } : {}
                }, extraOptions.chartOptions)
            });
        }

        // -------------------------------
        // 5. Create all charts safely
        // -------------------------------

        // Monthly Sales Trend (Line)
        safeCreateChart('salesTrendChart', 'line', months, monthlyRevenue, {
            datasetOptions: {
                label: 'Sales (₱)',
                borderColor: mmBlue,
                backgroundColor: 'rgba(11, 98, 143, 0.1)',
                tension: 0.35,
                borderWidth: 3,
                pointRadius: 4,
                fill: true
            },
            chartOptions: { scales: { y: { beginAtZero: false } } }
        });

        // Service Type Distribution (Pie) with legend at the bottom
        safeCreateChart('serviceTypeChart', 'pie', serviceTypes, serviceRevenue, {
            chartOptions: {
                plugins: {
                    legend: {
                        display: true,
                        position: 'bottom',
                        labels: { usePointStyle: true, padding: 12, boxWidth: 12 }
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                const label = context.label || '';
                                const value = context.formattedValue || '';
                                return `${label}: ₱${value}`;
                            }
                        }
                    }
                }
            }
        });

        // Top Clients by Revenue (Horizontal Bar)
        safeCreateChart('topClientsChart', 'bar', topClients, topClientsRevenue, {
            chartOptions: { indexAxis: 'y', scales: { x: { beginAtZero: true } } }
        });

        // Inventory Turnover Rate (Bar)
        safeCreateChart('turnoverChart', 'bar', turnoverCategories, turnoverValues, {
            chartOptions: { scales: { y: { beginAtZero: true } } }
        });

    </script>
}



