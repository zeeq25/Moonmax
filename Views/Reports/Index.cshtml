@{
    ViewData["Title"] = "Reports & Analytics";
    ViewData["Nav"] = "Reports";
    ViewData["AppShell"] = true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/tophead.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/reports.css" asp-append-version="true" />
}

<div class="page page-reports">

    <!-- HEADER -->
    <header class="dash-header">
        <div>
            <h1 class="dash-title">Reports &amp; Analytics</h1>
            <p class="dash-sub">Analyze performance, trends and transaction insights</p>
        </div>
    </header>

    <!-- OVERVIEW SECTION -->
    <section class="section-block">
        <h2 class="section-title">Overview</h2>

        <div class="dash-kpis kpi-grid">
            <a asp-controller="Reports" asp-action="SalesReport" class="dash-card kpi dash-card--link">
                <div class="kpi-icon"><i class="fa-solid fa-peso-sign"></i></div>
                <div class="kpi-content"><div class="kpi-title">Sales Report</div></div>
            </a>

            <a asp-controller="Reports" asp-action="InventoryReport" class="dash-card kpi dash-card--link">
                <div class="kpi-icon"><i class="fa-solid fa-box-archive"></i></div>
                <div class="kpi-content"><div class="kpi-title">Inventory Reports</div></div>
            </a>

            <a asp-controller="Reports" asp-action="JobOrderReport" class="dash-card kpi dash-card--link">
                <div class="kpi-icon"><i class="fa-solid fa-briefcase"></i></div>
                <div class="kpi-content"><div class="kpi-title">Job Order Reports</div></div>
            </a>

            <article class="dash-card kpi metric-card">
                <div class="kpi-icon"><i class="fa-solid fa-circle-check"></i></div>
                <div class="kpi-content">
                    <div class="kpi-title">Completion Rate</div>
                    <div class="kpi-main">92%</div>
                </div>
            </article>
        </div>
    </section>

    <!-- SALES ANALYTICS -->
    <section class="section-block">
        <h2 class="section-title">Sales Analytics</h2>

        <div class="reports-row">
            <article class="mm-card chart-card chart-card--wide">
                <header class="chart-card-header">
                    <h3>Monthly Sales Trend</h3>
                    <p>Revenue trend for the last 6 months.</p>
                </header>
                <div class="chart-card-body"><canvas id="salesTrendChart"></canvas></div>
            </article>

            <article class="mm-card chart-card">
                <header class="chart-card-header">
                    <h3>Service Type Distribution</h3>
                    <p>Job order share per service type.</p>
                </header>
                <div class="chart-card-body chart-card-body--pie">
                    <canvas id="serviceTypeChart"></canvas>
                </div>
            </article>
        </div>
    </section>

    <!-- CLIENT & INVENTORY -->
    <section class="section-block">
        <h2 class="section-title">Clients & Inventory</h2>

        <div class="reports-row">
            <article class="mm-card chart-card">
                <header class="chart-card-header">
                    <h3>Top Clients by Revenue</h3>
                    <p>Highest contributing customers.</p>
                </header>
                <div class="chart-card-body"><canvas id="topClientsChart"></canvas></div>
            </article>

            <article class="mm-card chart-card">
                <header class="chart-card-header">
                    <h3>Inventory Turnover Rate</h3>
                    <p>Stock movement by category.</p>
                </header>
                <div class="chart-card-body"><canvas id="turnoverChart"></canvas></div>
            </article>
        </div>
    </section>

    <!-- SUMMARY SECTION -->
    <section class="section-block">
        <h2 class="section-title">Monthly Summary</h2>

        <div class="reports-row reports-row--summary">

            <article class="mm-card">
                <header class="chart-card-header">
                    <h3>Performance Summary</h3>
                    <p>Key monthly operational metrics.</p>
                </header>

                <div class="summary-table-wrap">
                    <table class="mm-table">
                        <thead>
                            <tr>
                                <th>Month</th>
                                <th>Total Sales</th>
                                <th>Jobs Completed</th>
                                <th>Avg. Job Value</th>
                                <th>Growth</th>
                            </tr>
                        </thead>
                        <tbody>
                            @* (Your existing rows unchanged) *@
                        </tbody>
                    </table>
                </div>
            </article>

            <article class="mm-card insights-card">
                <header class="chart-card-header">
                    <h3>Key Highlights</h3>
                    <p>A quick snapshot of current performance.</p>
                </header>

                <ul class="insights-list">
                    <li><span class="insights-label">Best Month</span><span class="insights-value">Oct 2025 (₱284,500)</span></li>
                    <li><span class="insights-label">Strongest Growth</span><span class="insights-value insights-up">+16.2% (Jun 2025)</span></li>
                    <li><span class="insights-label">Weakest Month</span><span class="insights-value insights-down">Sep 2025 (–6.0%)</span></li>
                    <li><span class="insights-label">Top Client</span><span class="insights-value">Tech Industries – ₱450,000</span></li>
                    <li><span class="insights-label">Most Requested Service</span><span class="insights-value">Hydraulic Repair (35%)</span></li>
                </ul>
            </article>

        </div>
    </section>

</div>

@section Scripts {
    <!-- Chart.js for UI charts -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Monthly Sales Trend (Line)
        const salesTrendCtx = document.getElementById('salesTrendChart');
        if (salesTrendCtx) {
            new Chart(salesTrendCtx, {
                type: 'line',
                data: {
                    labels: ['May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct'],
                    datasets: [{
                        label: 'Sales (₱)',
                        data: [165000, 215000, 240000, 260000, 250000, 285000],
                        tension: 0.35,
                        borderWidth: 3,
                        pointRadius: 3
                    }]
                },
                options: {
                    plugins: { legend: { display: false } },
                    scales: { y: { beginAtZero: false } }
                }
            });
        }

        // Service Type Distribution (Pie)
        const serviceTypeCtx = document.getElementById('serviceTypeChart');
        if (serviceTypeCtx) {
            new Chart(serviceTypeCtx, {
                type: 'pie',
                data: {
                    labels: ['Hydraulic Repair', 'Turbo Repair', 'Metal Fabrication', 'Hydraulic Hose'],
                    datasets: [{ data: [35, 28, 22, 15] }]
                },
                options: { plugins: { legend: { position: 'bottom' } } }
            });
        }

        // Top Clients by Revenue (Horizontal Bar)
        const topClientsCtx = document.getElementById('topClientsChart');
        if (topClientsCtx) {
            new Chart(topClientsCtx, {
                type: 'bar',
                data: {
                    labels: ['Tech Industries', 'ABC Manufacturing', 'XYZ Corporation', 'Global Logistics', 'Metro Construction'],
                    datasets: [{ data: [450000, 300000, 150000, 120000, 90000] }]
                },
                options: {
                    indexAxis: 'y',
                    plugins: { legend: { display: false } },
                    scales: { x: { beginAtZero: true } }
                }
            });
        }

        // Inventory Turnover Rate (Bar)
        const turnoverCtx = document.getElementById('turnoverChart');
        if (turnoverCtx) {
            new Chart(turnoverCtx, {
                type: 'bar',
                data: {
                    labels: ['Hoses', 'Fittings', 'Turbo Parts', 'Metal Parts', 'Tools'],
                    datasets: [{ data: [85, 72, 68, 55, 43] }]
                },
                options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true } } }
            });
        }
    </script>
}
