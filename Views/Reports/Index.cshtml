@{
    ViewData["Title"] = "Reports & Analytics";
    ViewData["Nav"] = "Reports";
    ViewData["AppShell"] = true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/tophead.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/reports.css" asp-append-version="true" />    
}

<div class="page page-reports">

    <!-- HEADER -->
    <header class="dash-header">
        <div>
            <h1 class="dash-title">Reports &amp; Analytics</h1>
            <p class="dash-sub">Generate automated reports and analyze performance trends</p>
        </div>
    </header>

    <!-- REPORT NAVIGATION CARDS -->
    <section class="section-block">
        <div class="dash-cards">
            <a href="@Url.Action("SalesReport", "Reports")" class="dash-card nav-card">
                <div class="kpi-icon"><i class="fa-solid fa-file-invoice-dollar"></i></div>
                <div class="kpi-content">
                    <div class="kpi-title">Sales Report</div>
                    <div class="kpi-main">View detailed sales data</div>
                </div>
            </a>

            <a href="@Url.Action("JobReport", "Reports")" class="dash-card nav-card">
                <div class="kpi-icon"><i class="fa-solid fa-briefcase"></i></div>
                <div class="kpi-content">
                    <div class="kpi-title">Job Orders Report</div>
                    <div class="kpi-main">Track job order history</div>
                </div>
            </a>

            <a href="@Url.Action("InventoryReport", "Reports")" class="dash-card nav-card">
                <div class="kpi-icon"><i class="fa-solid fa-boxes-stacked"></i></div>
                <div class="kpi-content">
                    <div class="kpi-title">Inventory Report</div>
                    <div class="kpi-main">Check current inventory</div>
                </div>
            </a>
        </div>
    </section>

    <!-- QUICK OVERVIEW CHARTS -->
    <section class="section-block">
        <h2 class="section-title">Quick Overview Charts</h2>
        <div class="reports-row">
            <article class="chart-card chart-card--wide">
                <header class="chart-card-header">
                    <h3>Revenue Trend</h3>
                    <p>Monthly revenue overview.</p>
                </header>
                <div class="chart-card-body">
                    <canvas id="revenueTrendChart"></canvas>
                </div>
            </article>

            <article class="chart-card">
                <header class="chart-card-header">
                    <h3>Stock Balance</h3>
                    <p>Current stock by item.</p>
                </header>
                <div class="chart-card-body">
                    <canvas id="stockBalanceChart"></canvas>
                </div>
            </article>

            <!-- Jobs per Service Type -->
            <article class="chart-card">
                <header class="chart-card-header">
                    <h3>Jobs per Service Type</h3>
                    <p>Number of jobs grouped by service type.</p>
                </header>
                <div class="chart-card-body">
                    <canvas id="jobsPerServiceChart"></canvas>
                </div>
            </article>
        </div>
    </section>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Convert ViewBag data to JS arrays
        const months = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.Months ?? new List<string>()));
        const monthlyRevenue = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.MonthlyRevenue ?? new List<decimal>()));
        const stockItems = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.StockItems ?? new List<string>()));
        const stockValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.StockValues ?? new List<decimal>()));
        const jobsCompleted = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.JobsCompleted ?? new List<decimal>()));
        const jobsPending = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.JobsPending ?? new List<decimal>()));

        function generateColors(length, alpha=1) {
            const palette = ['#4F46E5','#FACC15','#10B981','#EF4444','#1F2937','#8B5CF6','#F472B6','#10B981'];
            return Array.from({length}, (_, i) => palette[i % palette.length]);
        }

        function formatCurrency(value) {
            return '₱' + Number(value).toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        // Global chart defaults for high-res
        Chart.defaults.devicePixelRatio = window.devicePixelRatio || 2;
        Chart.defaults.font.family = "'Inter', sans-serif";

        // Revenue Trend - Line Chart
        const revenueCtx = document.getElementById('revenueTrendChart');
        if (revenueCtx) {
            new Chart(revenueCtx, {
                type: 'line',
                data: {
                    labels: months,
                    datasets: [{
                        label: 'Revenue',
                        data: monthlyRevenue,
                        borderColor: '#4F46E5',
                        backgroundColor: 'rgba(79, 70, 229, 0.2)',
                        fill: true,
                        tension: 0.3,
                        pointRadius: 4,
                        pointHoverRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: true },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return formatCurrency(context.raw);
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) { return formatCurrency(value); }
                            }
                        }
                    }
                }
            });
        }

        // Stock Balance - Bar Chart
        const stockCtx = document.getElementById('stockBalanceChart');
        if (stockCtx) {
            new Chart(stockCtx, {
                type: 'bar',
                data: {
                    labels: stockItems,
                    datasets: [{
                        label: 'Stock Quantity',
                        data: stockValues,
                        backgroundColor: generateColors(stockItems.length)
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: true },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return context.dataset.label + ': ' + context.raw;
                                }
                            }
                        }
                    },
                    scales: { y: { beginAtZero: true } }
                }
            });
        }

        // Jobs per Service Type Chart
        const serviceTypes = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ServiceTypes ?? new List<string>()));
        const serviceCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ServiceCounts ?? new List<int>()));

        const jobsCtx = document.getElementById('jobsPerServiceChart');
        if (jobsCtx && serviceTypes.length && serviceCounts.length) {
            new Chart(jobsCtx, {
                type: 'bar',
                data: {
                    labels: serviceTypes,
                    datasets: [{
                        label: 'Number of Jobs',
                        data: serviceCounts,
                        backgroundColor: generateColors(serviceTypes.length),
                        borderColor: '#1F2937',
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return context.dataset.label + ': ' + context.raw;
                                }
                            }
                        }
                    },
                    scales: {
                        y: { beginAtZero: true, title: { display: true, text: 'Number of Jobs' } },
                        x: { title: { display: true, text: 'Service Type' } }
                    }
                }
            });
        }
        
    </script>
}


