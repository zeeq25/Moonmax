@model Moonmax.ViewModels.InventoryReportVM

@{
    ViewData["Title"] = "Inventory Reports";
    ViewData["Nav"] = "Reports";
    ViewData["AppShell"] = true;
}

@{
    var generatedByUser = User.Identity?.IsAuthenticated == true
        ? User.Identity.Name
        : "Unknown User";
}


@section Styles {
    <link rel="stylesheet" href="~/css/tophead.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/reports.css" asp-append-version="true" />
}

<div class="page page-reports">

    <!-- HEADER -->
    <header class="dash-header">
        <div>
            <h1 class="dash-title">Inventory Reports</h1>
            <p class="dash-sub">Analyze stock levels and material usage trends</p>
            <button id="btnBack" class="modern-btn modern-btn-back"><i class="fa-solid fa-arrow-left"></i> Back</button>
        </div>
    </header>

    <!-- KPIs -->
    <section class="section-block">
        <div class="dash-kpis">

            <article class="dash-card kpi">
                <div class="kpi-icon"><i class="fa-solid fa-peso-sign"></i></div>
                <div class="kpi-content">
                    <div class="kpi-title">Total Stock Value</div>
                    <div class="kpi-main">₱@Model.TotalStockValue.ToString("N2")</div>
                </div>
            </article>

            <article class="dash-card kpi">
                <div class="kpi-icon"><i class="fa-solid fa-box-archive"></i></div>
                <div class="kpi-content">
                    <div class="kpi-title">Total Stock Added</div>
                    <div class="kpi-main">@Model.TotalStockAdded</div>
                </div>
            </article>

            <article class="dash-card kpi">
                <div class="kpi-icon"><i class="fa-solid fa-truck-arrow-right"></i></div>
                <div class="kpi-content">
                    <div class="kpi-title">Total Stock Used</div>
                    <div class="kpi-main">@Model.TotalStockUsed</div>
                </div>
            </article>

            <article class="dash-card kpi">
                <div class="kpi-icon"><i class="fa-solid fa-exclamation-triangle"></i></div>
                <div class="kpi-content">
                    <div class="kpi-title">Low Stock Items</div>
                    <div class="kpi-main">@Model.LowStockCount</div>
                </div>
            </article>

        </div>
    </section>

    <!-- INVENTORY REPORTS -->
    <section class="section-block">
        <h2 class="section-title">Inventory Reports</h2>


        
        
        <!-- DATE RANGE & EXPORT -->
        <section class="section-block filters-export">
            <div class="filters modern-filters">

                <!--Date range & filter button-->
                <div class="date-range">
                    <label>From:</label>
                    <input type="date" id="reportFromDate" value="@ViewBag.FromDate" class="modern-input" />
                    <label>To:</label>
                    <input type="date" id="reportToDate" value="@ViewBag.ToDate" class="modern-input" />

                    <button id="btnApplyFilter" class="modern-btn modern-btn-primary" style="margin-left:10px;">
                        <i class="fa-solid fa-filter"></i> Apply Filter
                    </button>
                </div>



                <!-- Search + Export -->
                <div class="filter-actions-group" style="display:flex; align-items:center; gap:10px; margin-top:10px;">
                    <input type="text"
                           id="searchFilter"
                           class="modern-input"
                           placeholder="Search part, category, or supplier…" />

                    <button id="btnExportPdf" class="modern-btn modern-btn-primary">
                        <i class="fa-solid fa-file-pdf"></i> Export PDF
                    </button>
                </div>
                
            </div>
        </section>

        <!-- INVENTORY TABLE -->
        <div class="mm-card table-card">
            <header class="chart-card-header">
                <h3>Inventories</h3>
                <p>All inventory items and their stock levels</p>
            </header>

            <div class="table-responsive">
                <table id="inventoryTable" class="modern-table striped hover" style="width:100%; table-layout:fixed;">
                    <thead>
                        <tr>
                            <th>Item ID</th>
                            <th>Category</th>
                            <th>Part Name</th>
                            <th>Unit Cost</th>
                            <th>Quantity In Stock</th>
                            <th>Reorder Level</th>
                            <th>Supplier</th>
                            <th>Updated At</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Inventories)
                        {
                            <tr>
                                <td>@item.InventoryID</td>
                                <td>@item.Category</td>
                                <td>@item.PartName</td>
                                <td>₱@item.UnitCost.ToString("N2")</td>
                                <td>@item.QuantityInStock</td>
                                <td>@item.ReorderLevel</td>
                                <td>@item.SupplierName</td>
                                <td>@item.UpdatedAt?.ToString("yyyy-MM-dd")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>


        <!-- Pagination Controls -->
        <div id="inventoryPagination" class="pagination-modal" style="text-align:center; margin-top:10px;">
            <button class="pg-btn" id="prevPage">‹ Prev</button>
            <span id="pageIndicator">Page 1</span>
            <button class="pg-btn" id="nextPage">Next ›</button>
        </div>


        <!-- Charts -->
        <div class="reports-row">

            <article class="mm-card chart-card">
                <header class="chart-card-header">
                    <h3>Stock Balance by Item</h3>
                    <p>Current stock per item</p>
                </header>
                <div class="chart-card-body" style="height:280px;">
                    <canvas id="stockBalanceChart"></canvas>
                </div>
            </article>

            <article class="mm-card chart-card">
                <header class="chart-card-header">
                    <h3>Top 5 Consumed Items</h3>
                    <p>Most used items based on stock movements (OUT)</p>
                </header>
                <div class="chart-card-body" style="height:260px;">
                    <canvas id="materialUsageChart"></canvas>
                </div>
            </article>

        </div>

    </section>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", () => {


         
            const generatedByUser = "@generatedByUser";

            // Prevent multiple bindings
            const exportBtn = document.getElementById('btnExportPdf');
            exportBtn.replaceWith(exportBtn.cloneNode(true));
            const btnExportPdf = document.getElementById('btnExportPdf');

            // ------------------------------
            // BACK BUTTON
            // ------------------------------
            document.getElementById('btnBack').addEventListener('click', () => {
                window.history.back();
            });

            // ------------------------------
            // TABLE & PAGINATION
            // ------------------------------
            let currentPage = 1;
            const rowsPerPage = 10;
            let allRows = Array.from(document.querySelectorAll("#inventoryTable tbody tr"));
            allRows.forEach(r => r.dataset.filtered = "true");

            function getVisibleRows() {
                return allRows.filter(r => r.dataset.filtered === "true");
            }

            function renderTablePage(page) {
                const visibleRows = getVisibleRows();
                const totalPages = Math.ceil(visibleRows.length / rowsPerPage);
                if (page < 1) page = 1;
                if (page > totalPages && totalPages > 0) page = totalPages;
                currentPage = page;

                allRows.forEach(r => r.style.display = "none");

                const startIdx = (page - 1) * rowsPerPage;
                const endIdx = startIdx + rowsPerPage;
                visibleRows.slice(startIdx, endIdx).forEach(r => r.style.display = "");

                document.getElementById("pageIndicator").innerText = `Page ${page} of ${totalPages || 1}`;
                document.getElementById("prevPage").disabled = (page <= 1);
                document.getElementById("nextPage").disabled = (page >= totalPages);
            }

            document.getElementById("prevPage").onclick = () => renderTablePage(currentPage - 1);
            document.getElementById("nextPage").onclick = () => renderTablePage(currentPage + 1);
            renderTablePage(currentPage);

            // ------------------------------
            // SEARCH & FILTER
            // ------------------------------
            const searchInput = document.getElementById('searchFilter');
            const fromDateInput = document.getElementById('reportFromDate');
            const toDateInput = document.getElementById('reportToDate');
            const filterBtn = document.getElementById('btnApplyFilter');

            function applyFilters() {
                const search = searchInput.value.toLowerCase().trim();
                const fromDate = fromDateInput.value ? new Date(fromDateInput.value) : null;
                const toDate = toDateInput.value ? new Date(toDateInput.value) : null;
                if (toDate) toDate.setHours(23, 59, 59, 999);

                allRows.forEach(row => {
                    const updatedAtText = row.cells[7].innerText.trim();
                    const updatedAt = updatedAtText ? new Date(updatedAtText) : null;
                    const partName = row.cells[2].innerText.toLowerCase();
                    const supplier = row.cells[6].innerText.toLowerCase();
                    const category = row.cells[1].innerText.toLowerCase();

                    const matchesSearch = !search || partName.includes(search) || supplier.includes(search) || category.includes(search);
                    let matchesDate = true;
                    if (updatedAt) {
                        if (fromDate && updatedAt < fromDate) matchesDate = false;
                        if (toDate && updatedAt > toDate) matchesDate = false;
                    } else matchesDate = false;

                    row.dataset.filtered = (matchesSearch && matchesDate) ? "true" : "false";
                });

                renderTablePage(1);
            }

            searchInput.addEventListener('input', applyFilters);
            filterBtn.addEventListener('click', applyFilters);

            // ------------------------------
            // CHARTS
            // ------------------------------
            const stockItems = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Inventories.Select(i => i.PartName)));
            const stockValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Inventories.Select(i => i.QuantityInStock)));
            const usageDates = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.UsageDates));
            const usageValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.UsageQuantities));

            function generateColors(length) {
                const palette = ['#4F46E5','#FACC15','#10B981','#EF4444','#1F2937','#8B5CF6','#F472B6','#0EA5E9'];
                return Array.from({length}, (_, i) => palette[i % palette.length]);
            }

            function createChart(ctxId, type, labels, data, options={}) {
                const canvas = document.getElementById(ctxId);
                if (!canvas || !labels.length || !data.length) return;
                return new Chart(canvas, { type, data: { labels, datasets:[{ data, backgroundColor: generateColors(labels.length) }] }, options: { responsive:true, maintainAspectRatio:false, ...options } });
            }

            createChart('stockBalanceChart','bar',stockItems,stockValues,{ plugins:{ legend:{ display:false } }, scales:{ y:{ beginAtZero:true } } });
            createChart('materialUsageChart','bar',usageDates,usageValues,{ plugins:{ legend:{ display:false } }, scales:{ y:{ beginAtZero:true } } });

            // ------------------------------
            // EXPORT PDF (fixed)
            // ------------------------------
                        btnExportPdf.addEventListener('click', () => {
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF('p', 'mm', 'a4');

            const filteredRows = getVisibleRows();
            if (!filteredRows.length) return alert("No data to export.");

            // COUNT PARTS & SUPPLIERS
            const partCounts = {}, supplierCounts = {};
            filteredRows.forEach(row => {
                const part = row.cells[2].innerText.trim();
                partCounts[part] = (partCounts[part] || 0) + 1;
                const supplier = row.cells[6].innerText.trim();
                supplierCounts[supplier] = (supplierCounts[supplier] || 0) + 1;
            });

            // Get Top 3 parts (names only)
            const topPartsArr = Object.keys(partCounts)
                .sort((a, b) => partCounts[b] - partCounts[a])
                .slice(0, 3);

            // Top supplier
            const topSupplier = Object.keys(supplierCounts)
                .sort((a, b) => supplierCounts[b] - supplierCounts[a])[0] || "N/A";

            // Extract table data
            const tableBody = filteredRows.map(row =>
                Array.from(row.cells).map((cell, i) =>
                    i === 3 ? 'PHP ' + cell.innerText.replace(/₱/g, '').trim() : cell.innerText.trim()
                )
            );

            // KPIs
            let totalStockValue = 0, lowStockCount = 0;
            filteredRows.forEach(row => {
                const qty = parseFloat(row.cells[4].innerText) || 0;
                const unitCost = parseFloat(row.cells[3].innerText.replace(/₱/g, '').replace(/,/g, '')) || 0;
                const reorder = parseInt(row.cells[5].innerText) || 0;
                totalStockValue += qty * unitCost;
                if (qty <= reorder) lowStockCount++;
            });

            // REPORT PERIOD
            const fromDate = document.getElementById('reportFromDate').value;
            const toDate = document.getElementById('reportToDate').value;
            const formattedFromDate = fromDate ? new Date(fromDate).toLocaleDateString('en-US', { year:'numeric', month:'short', day:'numeric' }) : "N/A";
            const formattedToDate = toDate ? new Date(toDate).toLocaleDateString('en-US', { year:'numeric', month:'short', day:'numeric' }) : "N/A";

            // -------------------- HEADER --------------------
            doc.setFont('helvetica','bold'); doc.setFontSize(18);
            doc.text("INVENTORY REPORT", 105, 20, { align: 'center' });

            doc.setFont('helvetica','normal'); doc.setFontSize(10);
            doc.text(`Generated by: ${generatedByUser}`, 10, 28);
            doc.text(`Generated on: ${new Date().toLocaleString()}`, 10, 33);
            doc.text(`Report Period: ${formattedFromDate} - ${formattedToDate}`, 10, 38);
            doc.line(10, 41, 200, 41);

            // -------------------- SUMMARY BOX --------------------
            let startY = 45;
            doc.setFillColor(245,247,250);
            doc.roundedRect(10, startY, 190, 45, 3, 3, 'F');
            const col = 95;

            doc.setFontSize(9); doc.text("Top Supplier:", 15, startY + 8);
            doc.setFontSize(11); doc.text(topSupplier, 15, startY + 13);

            doc.setFontSize(9); doc.text("Top Parts:", 15 + col, startY + 8);
            doc.setFontSize(11); doc.text(topPartsArr.join(", ") || "N/A", 15 + col, startY + 13);

            doc.setFontSize(9); doc.text("Total Stock Value (PHP):", 15, startY + 23);
            doc.setFontSize(11); doc.text(`PHP ${totalStockValue.toLocaleString('en-US',{minimumFractionDigits:2})}`, 15, startY + 28);

            doc.setFontSize(9); doc.text("Low Stock Items:", 15 + col, startY + 23);
            doc.setFontSize(11); doc.text(`${lowStockCount}`, 15 + col, startY + 28);

            doc.setFontSize(9); doc.text("Number of Items Listed:", 15 + col, startY + 33);
            doc.setFontSize(11); doc.text(`${filteredRows.length}`, 15 + col, startY + 38);

            startY += 55;

            // -------------------- TABLE --------------------
            doc.autoTable({
                startY,
                head: [['ID','Category','Part','Unit Cost','Qty In Stock','Reorder','Supplier','Updated At']],
                body: tableBody,
                theme: 'striped',
                headStyles: { fillColor: [79,70,229], textColor: 255 },
                styles: { fontSize: 8 },
                showHead: 'everyPage',
                margin: { left: 7, right: 7 }
            });

            // -------------------- SAVE PDF --------------------
            doc.save(`InventoryReport_${fromDate || 'all'}_to_${toDate || 'all'}.pdf`);
        });


        });
    </script>
}


    






    
   
