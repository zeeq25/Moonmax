@model Moonmax.ViewModels.JobOrderReportVM

@{
    ViewData["Title"] = "Job Reports";
    ViewData["Nav"] = "Reports";
    ViewData["AppShell"] = true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/tophead.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/reports.css" asp-append-version="true" />
}

<div class="page page-reports">

    <!-- HEADER -->
    <header class="dash-header">
        <div>
            <h1 class="dash-title">Job Order Reports</h1>
            <p class="dash-sub">Generate automated reports and analyze job performance</p>

            <!--Back Button-->
            <button id="btnBack" class="modern-btn modern-btn-back"><i class="fa-solid fa-arrow-left"></i> Back</button>
        </div>
    </header>

    <!-- KPIs -->
    <section class="section-block">
        <div class="dash-kpis">

            <!-- TOTAL JOBS -->
            <article class="dash-card kpi">
                <div class="kpi-icon"><i class="fa-solid fa-list-check"></i></div>
                <div class="kpi-content">
                    <div class="kpi-title">Total Jobs</div>
                    <div class="kpi-main">@Model.TotalJobs</div>
                </div>
            </article>

            <!-- COMPLETED JOBS -->
            <article class="dash-card kpi">
                <div class="kpi-icon"><i class="fa-solid fa-check-circle"></i></div>
                <div class="kpi-content">
                    <div class="kpi-title">Completed</div>
                    <div class="kpi-main">@Model.CompletedJobs</div>
                </div>
            </article>

            <!-- PENDING JOBS -->
            <article class="dash-card kpi">
                <div class="kpi-icon"><i class="fa-solid fa-clock"></i></div>
                <div class="kpi-content">
                    <div class="kpi-title">Pending</div>
                    <div class="kpi-main">@Model.PendingJobs</div>
                </div>
            </article>

            
            <!-- JOB REVENUE -->
            <article class="dash-card kpi">
                <div class="kpi-icon"><i class="fa-solid fa-peso-sign"></i></div>
                <div class="kpi-content">
                    <div class="kpi-title">Job Labor Revenue</div>
                    <div class="kpi-main">₱@Model.JobRevenue.ToString("N2")</div>
                </div>
            </article>

        </div>
    </section>

    <!-- JOB ORDER REPORT -->
    <section class="section-block">
        <h2 class="section-title">Job Order Reports</h2>

        <!-- FILTERS -->
        <section class="section-block filters-export">
            <div class="filters modern-filters" style="display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; justify-content: space-between;">

                <!-- DATE RANGE -->
                <div class="date-range" style="display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center;">
                    <label>From:</label>
                    <input type="date" id="reportFromDate"
                           value="@DateTime.Now.AddDays(-30).ToString("yyyy-MM-dd")"
                           class="modern-input" />

                    <label>To:</label>
                    <input type="date" id="reportToDate"
                           value="@DateTime.Now.ToString("yyyy-MM-dd")"
                           class="modern-input" />

                    <!-- ✅ APPLY FILTER BUTTON -->
                    <button id="btnApplyFilter" class="modern-btn modern-btn-primary" style="padding: 8px 16px; background-color:#4F46E5; color:#fff;">
                        <i class="fa-solid fa-filter"></i> Apply Filter
                    </button>
                </div>

                <!-- STATUS + EXPORT -->
                <div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
                    <!-- STATUS DROPDOWN -->
                    <div class="status-filter">
                        <label>Status:</label>
                        <select id="jobStatusFilter" class="modern-input">
                            <option value="">All Status</option>
                            @foreach (var status in Model.FiltersStatuses)
                            {
                                <option value="@status">@status</option>
                            }
                        </select>
                    </div>

                    <!-- ✅ EXPORT PDF BUTTON -->
                    <button id="btnExportPdf" class="modern-btn modern-btn-export" style="padding: 8px 16px; background-color:#4F46E5; color:#fff;">
                        <i class="fa-solid fa-file-pdf"></i> Export PDF
                    </button>
                </div>

            </div>
        </section>

        <!-- JOB ORDER TABLE -->
        <div class="mm-card table-card">
            <header class="table-card-header">
                <h3>Job Order List</h3>
                <p>Filtered job order details</p>
            </header>

            @if (Model.JobOrderList != null && Model.JobOrderList.Any())
            {
                <div class="table-responsive">
                    <table id="jobReportsTable" class="modern-table">
                        <thead>
                            <tr>
                                <th>Job ID</th>
                                <th>Client</th>
                                <th>Technician</th>
                                <th>Service</th>
                                <th>Parts/Items</th> 
                                <th>Total Cost</th>                                
                                <th>Date Created</th>
                                <th>Due Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>


                        <tbody>
                            @foreach (var j in Model.JobOrderList)
                            {
                                <tr>
                                    <td>@j.JobID</td>
                                    <td>@j.ClientName</td>
                                    <td>@j.TechnicianName</td>
                                    <td>@j.ServiceType</td>
                                    <td>
                                        @if (j.Parts != null && j.Parts.Any())
                                        {
                                            @string.Join(", ", j.Parts)
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    </td>
                                    <td>₱@j.Cost.ToString("N2")</td>                                                                        
                                    <td>@j.CreatedAt.ToString("yyyy-MM-dd")</td>
                                    <td>@(j.DueDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                                    <td>@j.Status</td>

                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="no-data">No Job Orders found for the selected filters.</p>
            }
        </div>

        <!--Pagination Modal-->
        <div class="job-table-pagination table-pagination" style="text-align:center; margin-bottom: 20px;">
            <button class="pg-btn" onclick="changeJobPage(-1)">‹</button>
            <span id="jobReportPageIndicator">Page 1</span>
            <button class="pg-btn" onclick="changeJobPage(1)">›</button>
        </div>


        <!-- CHARTS -->
        <div class="reports-row" style="display:flex; flex-wrap:wrap; gap:1rem;">
            <article class="mm-card chart-card chart-card--wide" style="flex:1 1 400px; min-width:300px;">
                <header class="chart-card-header">
                    <h3>Jobs per Service Type</h3>
                </header>
                <div class="chart-card-body" style="height:280px; position:relative;">
                    <canvas id="serviceTypeChart"></canvas>
                </div>
            </article>

            <article class="mm-card chart-card" style="flex:1 1 400px; min-width:300px;">
                <header class="chart-card-header">
                    <h3>Jobs Over Time</h3>
                </header>
                <div class="chart-card-body" style="height:280px; position:relative;">
                    <canvas id="jobDateChart"></canvas>
                </div>
            </article>
        </div>


        
    </section>

</div>

@section Scripts {
    <!-- EXTERNAL LIBRARIES -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.31/jspdf.plugin.autotable.min.js"></script>

    <script>
        @{
                var generatedByUser = User.Identity?.IsAuthenticated == true
                        ? User.Identity.Name
                        : "Unknown User";
        }
        const generatedByUser = "@generatedByUser";

        // ========================================
        // 1. CHART DATA & INITIALIZATION
        // ========================================
        const serviceTypes = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartServiceTypes));
        const serviceCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartServiceCounts));
        const chartDates = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartDates));
        const chartDateCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartDateCounts));

        function generateColors(length) {
            const palette = ['#4F46E5','#10B981','#FACC15','#EF4444','#1F2937','#8B5CF6','#F472B6','#0EA5E9'];
            return Array.from({length}, (_, i) => palette[i % palette.length]);
        }

        function createChart(ctxId, type, labels, data) {
            const canvas = document.getElementById(ctxId);
            if (!canvas || !labels.length) return;

            new Chart(canvas, {
                type,
                data: {
                    labels,
                    datasets: [{
                        data,
                        backgroundColor: generateColors(labels.length),
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: true }
                    },
                    scales: type === 'bar' ? {
                        y: { beginAtZero: true }
                    } : {}
                }
            });
        }

        // Initialize charts
        createChart('serviceTypeChart', 'bar', serviceTypes, serviceCounts);
        createChart('jobDateChart', 'line', chartDates, chartDateCounts);

        // ========================================
        // 2. TABLE FILTERING & PAGINATION
        // ========================================
        document.addEventListener("DOMContentLoaded", function() {
            const table = document.getElementById("jobReportsTable");
            if (!table) return;

            const rows = Array.from(table.querySelectorAll("tbody tr"));
            const rowsPerPage = 10;
            let currentPage = 1;

            // Get filter elements
            const fromDateInput = document.getElementById('reportFromDate');
            const toDateInput = document.getElementById('reportToDate');
            const statusFilterSelect = document.getElementById('jobStatusFilter');
            const applyFilterBtn = document.getElementById('btnApplyFilter');

            // ✅ SHARED FILTER FUNCTION - Used by both pagination AND export
            function getFilteredRows() {
                const fromDate = fromDateInput.value;
                const toDate = toDateInput.value;
                const statusFilter = statusFilterSelect.value;

                const from = fromDate ? new Date(fromDate) : null;
                const to = toDate ? new Date(toDate) : null;
                if (to) to.setHours(23, 59, 59, 999); // Include entire end date

                return rows.filter(row => {
                    const cells = row.querySelectorAll('td');
                    const dateCreated = new Date(cells[6].textContent); // Date Created column
                    const status = cells[8].textContent.trim(); // Status column

                    // Date range filter
                    const inDateRange = (!from || dateCreated >= from) && (!to || dateCreated <= to);

                    // Status filter - empty string means "All Status"
                    const statusMatch = !statusFilter || status === statusFilter;

                    return inDateRange && statusMatch;
                });
            }

            // ✅ PAGINATION - Only shows filtered rows (10 per page)
            function renderTablePage(page) {
                const filteredRows = getFilteredRows(); // Get ALL filtered rows
                const totalPages = Math.ceil(filteredRows.length / rowsPerPage) || 1;

                // Validate page number
                if (page < 1) page = 1;
                if (page > totalPages) page = totalPages;
                currentPage = page;

                // Hide ALL rows first
                rows.forEach(row => row.style.display = "none");

                // Show only CURRENT PAGE of filtered rows
                const start = (page - 1) * rowsPerPage;
                const end = start + rowsPerPage;
                filteredRows.slice(start, end).forEach(row => row.style.display = "");

                // Update page indicator
                const indicator = document.getElementById("jobReportPageIndicator");
                if (indicator) {
                    indicator.textContent = `Page ${page} of ${totalPages} (${filteredRows.length} records)`;
                }

                // Enable/disable pagination buttons
                const buttons = document.querySelectorAll(".job-table-pagination .pg-btn");
                if (buttons.length === 2) {
                    buttons[0].disabled = page === 1;
                    buttons[1].disabled = page === totalPages;
                }
            }

            // Pagination navigation (global for inline onclick)
            window.changeJobPage = function(step) {
                renderTablePage(currentPage + step);
            }

            // ✅ EVENT LISTENERS - Re-render pagination when filters change
            applyFilterBtn.addEventListener('click', () => {
                currentPage = 1; // Reset to first page
                renderTablePage(currentPage);
            });

            statusFilterSelect.addEventListener('change', () => {
                currentPage = 1; // Reset to first page
                renderTablePage(currentPage);
            });

            // Initial render
            renderTablePage(currentPage);

            // ✅ MAKE getFilteredRows AVAILABLE TO EXPORT
            window.getFilteredJobRows = getFilteredRows;
        });

                // ========================================
        // 3. EXPORT PDF - Exports ALL Filtered Data
        // ========================================
        document.getElementById('btnExportPdf').addEventListener('click', function() {
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF('p', 'mm', 'a4');
            const table = document.getElementById('jobReportsTable');

            if (!table) {
                alert("No data to export.");
                return;
            }

            // ===============================
            // GET FILTER VALUES
            // ===============================
            const fromDate = document.getElementById('reportFromDate').value;
            const toDate = document.getElementById('reportToDate').value;
            const selectedStatus = document.getElementById('jobStatusFilter').value;

            const from = new Date(fromDate);
            const to = new Date(toDate);
            to.setHours(23, 59, 59, 999);

            const formattedFromDate = from.toLocaleDateString('en-US', {
                year: 'numeric', month: 'short', day: 'numeric'
            });

            const formattedToDate = to.toLocaleDateString('en-US', {
                year: 'numeric', month: 'short', day: 'numeric'
            });

            // ===============================
            // ✅ GET ALL FILTERED ROWS (Not just visible page!)
            // ===============================
            const filteredRows = window.getFilteredJobRows ? window.getFilteredJobRows() : [];

            if (!filteredRows.length) {
                alert("No data to export with current filters.");
                return;
            }

            console.log(`📄 Exporting ${filteredRows.length} filtered records (including hidden pages)`);

            // ===============================
            // ✅ CALCULATE SUMMARY (ALL FILTERED DATA)
            // ===============================
            let totalJobCost = 0;
            let serviceTotals = {};
            let partsCounts = {}; // Track parts/items frequency
            let statusCounts = {};
            let jobCount = filteredRows.length;

            filteredRows.forEach(row => {
                const cost = parseFloat(
                    row.cells[5].textContent.replace('₱', '').replace(/,/g, '')
                ) || 0;

                const serviceType = row.cells[3].textContent.trim();
                const partsText = row.cells[4].textContent.trim(); // Parts/Items column
                const status = row.cells[8].textContent.trim();

                totalJobCost += cost;
                serviceTotals[serviceType] = (serviceTotals[serviceType] || 0) + cost;
                statusCounts[status] = (statusCounts[status] || 0) + 1;

                // ✅ Count parts/items (split by comma if multiple)
                if (partsText && partsText !== '-') {
                    const parts = partsText.split(',').map(p => p.trim());
                    parts.forEach(part => {
                        if (part) {
                            partsCounts[part] = (partsCounts[part] || 0) + 1;
                        }
                    });
                }
            });

            const avgJobValue = jobCount ? totalJobCost / jobCount : 0;

            // ✅ Top Service Type
            let topServiceType = "N/A";
            let maxRevenue = 0;
            for (const service in serviceTotals) {
                if (serviceTotals[service] > maxRevenue) {
                    maxRevenue = serviceTotals[service];
                    topServiceType = service;
                }
            }

            // ✅ Top Parts/Items (most frequently used)
            let topPart = "N/A";
            let maxPartCount = 0;
            for (const part in partsCounts) {
                if (partsCounts[part] > maxPartCount) {
                    maxPartCount = partsCounts[part];
                    topPart = part;
                }
            }

            // ✅ Jobs Completed
            const jobsCompleted = statusCounts['Completed'] || 0;

            // Formatted strings
            const totalJobRevenue = `PHP ${totalJobCost.toLocaleString('en-US', { minimumFractionDigits: 2 })}`;
            const avgJobValueFormatted = `PHP ${avgJobValue.toLocaleString('en-US', { minimumFractionDigits: 2 })}`;

            // ===============================
            // HEADER
            // ===============================
            doc.setFont('helvetica', 'bold');
            doc.setFontSize(18);
            doc.text("JOB ORDER REPORT", 105, 20, { align: 'center' });

            doc.setFont('helvetica', 'normal');
            doc.setFontSize(10);
            doc.text(`Report Period: ${formattedFromDate} - ${formattedToDate}`, 105, 28, { align: 'center' });

            if (selectedStatus) {
                doc.setFontSize(9);
                doc.text(`Status Filter: ${selectedStatus}`, 105, 34, { align: 'center' });
            }

            doc.setFontSize(8);
            doc.setTextColor(100);
            doc.text(`Generated by: ${generatedByUser}`, 10, 38);
            doc.text(`Generated on: ${new Date().toLocaleString()}`, 10, 42);

            doc.line(10, 45, 200, 45);

            // ===============================
            // ✅ SUMMARY SECTION (UPDATED)
            // ===============================
            let startY = 52;

            doc.setFillColor(245, 247, 250);
            doc.roundedRect(10, startY, 190, 55, 3, 3, 'F');

            doc.setTextColor(0);
            doc.setFontSize(12);
            doc.setFont('helvetica', 'bold');
            doc.text("Report Summary", 105, startY + 7, { align: 'center' });
            doc.setFont('helvetica', 'normal');

            const kpiY = startY + 15;
            const col = 63;

            // ✅ Row 1: Total Jobs | Jobs Completed | Top Parts
            doc.setFontSize(9);
            doc.text("Total Jobs:", 15, kpiY);
            doc.setFontSize(11);
            doc.text(jobCount.toString(), 15, kpiY + 5);

            doc.setFontSize(9);
            doc.text("Jobs Completed:", 15 + col, kpiY);
            doc.setFontSize(11);
            doc.text(jobsCompleted.toString(), 15 + col, kpiY + 5);

            doc.setFontSize(9);
            doc.text("Top Parts:", 15 + col * 2, kpiY);
            doc.setFontSize(11);
            // Truncate if too long
            const displayTopPart = topPart.length > 15 ? topPart.substring(0, 15) + '...' : topPart;
            doc.text(displayTopPart, 15 + col * 2, kpiY + 5);

            // ✅ Row 2: Total Job Revenue | Avg Job Value | Top Service
            const row2Y = kpiY + 18;
            doc.setFontSize(9);
            doc.text("Total Job Revenue:", 15, row2Y);
            doc.setFontSize(11);
            doc.text(totalJobRevenue, 15, row2Y + 5);

            doc.setFontSize(9);
            doc.text("Avg Job Value:", 15 + col, row2Y);
            doc.setFontSize(11);
            doc.text(avgJobValueFormatted, 15 + col, row2Y + 5);

            doc.setFontSize(9);
            doc.text("Top Service:", 15 + col * 2, row2Y);
            doc.setFontSize(11);
            doc.text(topServiceType, 15 + col * 2, row2Y + 5);

            startY += 65;

            // ===============================
            // ✅ TABLE - ALL FILTERED ROWS (Font Size 8)
            // ===============================
            const tableBody = filteredRows.map(row => {
                const c = row.cells;
                return [
                    c[0].textContent, // Job ID
                    c[1].textContent, // Client
                    c[2].textContent, // Technician
                    c[3].textContent, // Service
                    c[4].textContent, // Parts/Items
                    c[5].textContent.replace('₱', 'PHP '), // Total Cost
                    c[6].textContent, // Date Created
                    c[7].textContent, // Due Date
                    c[8].textContent  // Status
                ];
            });

            doc.autoTable({
            startY,
            head: [['Job ID', 'Client', 'Technician', 'Service', 'Parts/Items', 'Total Cost', 'Date Created', 'Due Date', 'Status']],
            body: tableBody,
            theme: 'striped',
            showHead: 'everyPage',
            styles: {
                fontSize: 7,           // Reduced from 8
                cellPadding: 1.5,      // Reduced from 2
                overflow: 'linebreak',
                halign: 'left'         // Added alignment
            },
            headStyles: {
                fillColor: [79, 70, 229],
                textColor: 255,
                fontStyle: 'bold',
                fontSize: 7            // Reduced from 8
            },
            columnStyles: {
                0: { cellWidth: 16 },   // Job ID (reduced from 18)
                1: { cellWidth: 22 },   // Client (reduced from 25)
                2: { cellWidth: 20 },   // Technician (reduced from 25)
                3: { cellWidth: 22 },   // Service (reduced from 25)
                4: { cellWidth: 28 },   // Parts/Items (reduced from 30)
                5: { cellWidth: 20 },   // Total Cost (reduced from 22)
                6: { cellWidth: 20 },   // Date Created (reduced from 22)
                7: { cellWidth: 18 },   // Due Date (reduced from 22)
                8: { cellWidth: 18 }    // Status (same)
            },
            margin: { left: 10, right: 10 }  // Added explicit margins
        });

            // Add footer with record count
            const finalY = doc.lastAutoTable.finalY || startY;
            doc.setFontSize(8);
            doc.setTextColor(100);
            doc.text(`Total Records Exported: ${jobCount}`, 10, finalY + 10);

            doc.save(`JobOrderReport_${fromDate}_to_${toDate}.pdf`);

            console.log(`✅ PDF exported successfully with ${jobCount} records`);
        });

        // ========================================
        // 4. BACK BUTTON
        // ========================================
        document.getElementById('btnBack').addEventListener('click', function() {
            window.history.back();
        });
    </script>
}
