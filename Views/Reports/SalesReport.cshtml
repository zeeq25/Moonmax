@using Moonmax.ViewModels



@{
    ViewData["Title"] = "Sales Report";
    ViewData["Nav"] = "Reports";
    ViewData["AppShell"] = true;

    // Cast ViewBag collections to dynamic lists for chart usage
    var monthlyRevenue = ViewBag.MonthlyRevenue as List<MonthlyRevenueViewModel>;
    var serviceRevenue = (List<ServiceRevenueViewModel>)ViewBag.ServiceRevenue;
    var recentInvoices = (List<Invoice>)ViewBag.RecentInvoices;
}

@section Styles {
    <link rel="stylesheet" href="~/css/tophead.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/reports.css" asp-append-version="true" />
}

<div class="page page-reports">

    <!-- HEADER -->
    <header class="dash-header" style="text-align: center; margin-bottom: 1rem;">
        <h1 class="dash-title">Sales Report</h1>
    </header>

    <!-- BACK BUTTON BELOW HEADER -->
    <div style="text-align: left; margin-bottom: 2rem;">
        <a href="@Url.Action("Index", "Reports")" class="btn btn-warning">
            <i class="fa-solid fa-arrow-left"></i> Back
        </a>
    </div>


    <!-- KPI CARDS -->
    <section class="dash-kpis">
        <article class="dash-card kpi">
            <div class="kpi-icon"><i class="fa-solid fa-peso-sign"></i></div>
            <div class="kpi-content">
                <div class="kpi-title">Total Revenue</div>
                <div class="kpi-main">@String.Format("₱{0:N0}", ViewBag.TotalRevenue)</div>
            </div>
        </article>
        <article class="dash-card kpi">
            <div class="kpi-icon"><i class="fa-solid fa-briefcase"></i></div>
            <div class="kpi-content">
                <div class="kpi-title">Total Jobs</div>
                <div class="kpi-main">@ViewBag.TotalJobs</div>
            </div>
        </article>
        <article class="dash-card kpi">
            <div class="kpi-icon"><i class="fa-solid fa-chart-line"></i></div>
            <div class="kpi-content">
                <div class="kpi-title">Avg. Job Value</div>
                <div class="kpi-main">@String.Format("₱{0:N0}", ViewBag.AvgJobValue)</div>
            </div>
        </article>
        <article class="dash-card kpi">
            <div class="kpi-icon"><i class="fa-solid fa-user"></i></div>
            <div class="kpi-content">
                <div class="kpi-title">Top Client</div>
                <div class="kpi-main">@ViewBag.TopClient?.ClientName (@String.Format("₱{0:N0}", ViewBag.TopClient?.Revenue))</div>
            </div>
        </article>
    </section>

    <!-- CHARTS -->
    <section class="reports-grid">

        <div class="reports-row reports-row--top">
            <article class="mm-card chart-card chart-card--wide">
                <div class="chart-card-header">
                    <h2>Monthly Sales Trend</h2>
                </div>
                <div class="chart-card-body">
                    <canvas id="monthlySalesChart"></canvas>
                </div>
            </article>

            <article class="mm-card chart-card">
                <div class="chart-card-header">
                    <h2>Sales by Service Type</h2>
                </div>
                <div class="chart-card-body chart-card-body--pie">
                    <canvas id="serviceTypeChart"></canvas>
                </div>
            </article>
        </div>


        <!-- EXPORT BUTTONS -->
        <div style="margin: 1rem 0;">
            <button class="btn btn-warning" onclick="exportTableToPDF('recentInvoicesTable', 'SalesReport')">Export to PDF</button>
            <button class="btn btn-secondary" onclick="window.print()">Print Report</button>
        </div>


        <!-- RECENT INVOICES TABLE -->
        <div class="reports-row reports-row--summary">
            <article class="mm-card">
                <div class="chart-card-header">
                    <h2>Recent Invoices</h2>
                </div>
                <div class="summary-table-wrap">
                    <table class="mm-table" id="recentInvoicesTable">
                        <thead>
                            <tr>
                                <th>Invoice #</th>
                                <th>Client</th>
                                <th>Date Issued</th>
                                <th>Amount</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var inv in recentInvoices)
                            {
                                <tr>
                                    <td>@inv.InvoiceNumber</td>
                                    <td>@inv.Client.Name</td>
                                    <td>@inv.DateIssued.ToString("yyyy-MM-dd")</td>
                                    <td>@String.Format("₱{0:N0}", inv.Amount)</td>
                                    <td>@inv.Status</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </article>
        </div>

    </section>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

    <script>
        // Function to set high-res canvas
        function setHiResCanvas(canvas) {
            const ctx = canvas.getContext('2d');
            const dpr = window.devicePixelRatio || 1;
            const rect = canvas.getBoundingClientRect();
            canvas.width = rect.width * dpr;
            canvas.height = rect.height * dpr;
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
            return ctx;
        }

        // Monthly Sales Chart
        const monthlyCanvas = document.getElementById('monthlySalesChart');
        if (monthlyCanvas) {
            const ctx = setHiResCanvas(monthlyCanvas);

            const gradient = ctx.createLinearGradient(0, 0, 0, monthlyCanvas.height);
            gradient.addColorStop(0, 'rgba(79,70,229,0.5)');
            gradient.addColorStop(1, 'rgba(79,70,229,0)');

            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(monthlyRevenue.Select(m => m.Month + "/" + m.Year))),
                    datasets: [{
                        label: 'Revenue (₱)',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(monthlyRevenue.Select(m => m.Revenue))),
                        borderWidth: 3,
                        borderColor: '#4f46e5',
                        backgroundColor: gradient,
                        tension: 0.4,
                        fill: true,
                        pointRadius: 6,
                        pointHoverRadius: 8,
                        pointBackgroundColor: '#4f46e5',
                        pointHoverBackgroundColor: '#10b981',
                        pointBorderWidth: 2,
                        pointHoverBorderWidth: 2,
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: true },
                        tooltip: { mode: 'index', intersect: false }
                    },
                    interaction: { mode: 'nearest', axis: 'x', intersect: false },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: { stepSize: 500 },
                            grid: { drawBorder: false, color: 'rgba(0,0,0,0.05)' }
                        },
                        x: {
                            grid: { drawBorder: false, color: 'rgba(0,0,0,0.05)' }
                        }
                    }
                }
            });
        }

        // Service Type Chart
        const serviceCanvas = document.getElementById('serviceTypeChart');
        if (serviceCanvas) {
            const ctx = setHiResCanvas(serviceCanvas);

            new Chart(ctx, {
                type: 'pie',
                data: {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(serviceRevenue.Select(s => s.ServiceType))),
                    datasets: [{
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(serviceRevenue.Select(s => s.Revenue))),
                        backgroundColor: ['#4f46e5','#10b981','#f59e0b','#ef4444','#6366f1'],
                        hoverOffset: 15,
                        borderWidth: 2,
                        borderColor: '#fff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom' },
                        tooltip: { callbacks: {
                            label: function(context) {
                                return `${context.label}: ₱${context.formattedValue}`;
                            }
                        }}
                    }
                }
            });
        }

        // PDF export function
        function exportTableToPDF(tableID, filename = 'SalesReport') {
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF('p', 'pt', 'a4');
            const table = document.getElementById(tableID);

            html2canvas(table, { scale: 2 }).then(canvas => {
                const imgData = canvas.toDataURL('image/png');
                const imgProps = doc.getImageProperties(imgData);
                const pdfWidth = doc.internal.pageSize.getWidth() - 40;
                const pdfHeight = (imgProps.height * pdfWidth) / imgProps.width;

                doc.addImage(imgData, 'PNG', 20, 20, pdfWidth, pdfHeight);
                doc.save(filename + '.pdf');
            });
        }
    </script>
}



