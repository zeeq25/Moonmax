@using Moonmax.ViewModels

@{
    ViewData["Title"] = "Sales Report";
    ViewData["Nav"] = "Reports";
    ViewData["AppShell"] = true;

    var monthlyRevenue = ViewBag.MonthlyRevenue as List<MonthlyRevenueViewModel> ?? new List<MonthlyRevenueViewModel>();
    var serviceRevenue = ViewBag.ServiceRevenue as List<ServiceRevenueViewModel> ?? new List<ServiceRevenueViewModel>();
    var allInvoices = ViewBag.AllInvoices as List<Invoice> ?? new List<Invoice>();
    var totalRevenue = ViewBag.TotalRevenue ?? 0;
    var totalJobs = ViewBag.TotalJobs ?? 0;
    var avgJobValue = ViewBag.AvgJobValue ?? 0;
    var topClient = ViewBag.TopClient;
}

@section Styles {
    <link rel="stylesheet" href="~/css/tophead.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/reports.css" asp-append-version="true" />
}

<div class="page-reports">

    <!-- HEADER -->
    <div class="header-bar">
        <div class="header-left">
            <a href="@Url.Action("Index", "Reports")" class="btn btn-warning">
                <i class="fa-solid fa-arrow-left"></i>
            </a>
            <h1 class="dash-title">Sales Report</h1>
        </div>
    </div>

    <!-- KPI CARDS -->
    <section class="kpi-wrapper">
        <article class="kpi">
            <div class="kpi-icon"><i class="fa-solid fa-peso-sign"></i></div>
            <div>
                <div class="kpi-title">Total Revenue</div>
                <div class="kpi-main">₱@(String.Format("{0:N0}", totalRevenue))</div>
            </div>
        </article>

        <article class="kpi">
            <div class="kpi-icon"><i class="fa-solid fa-briefcase"></i></div>
            <div>
                <div class="kpi-title">Total Jobs</div>
                <div class="kpi-main">@(totalJobs)</div>
            </div>
        </article>

        <article class="kpi">
            <div class="kpi-icon"><i class="fa-solid fa-chart-line"></i></div>
            <div>
                <div class="kpi-title">Avg. Job Value</div>
                <div class="kpi-main">₱@(String.Format("{0:N0}", avgJobValue))</div>
            </div>
        </article>

        <article class="kpi">
            <div class="kpi-icon"><i class="fa-solid fa-user"></i></div>
            <div>
                <div class="kpi-title">Top Client</div>
                <div class="kpi-main">
                    @(
                                        topClient != null
                                        ? $"{topClient.ClientName ?? "N/A"} (₱{String.Format("{0:N0}", topClient.Revenue ?? 0)})"
                                        : "N/A"
                                        )
                </div>
            </div>
        </article>
    </section>

    <!-- EXPORT BUTTONS -->
    <div class="export-row">
        <button class="btn btn-warning" onclick="exportTableToPDF('allInvoicesTable', 'SalesReport')">
            Export as PDF
        </button>
        <button class="btn btn-secondary" onclick="window.print()">
            Print Report
        </button>
    </div>

    <!-- INVOICES TABLE -->
    <div class="table-section">
        <div class="table-title">Invoices</div>
        <article class="mm-card">
            <div class="summary-table-wrap">
                <table class="mm-table" id="allInvoicesTable">
                    <thead>
                        <tr>
                            <th>Invoice #</th>
                            <th>Client</th>
                            <th>Date Issued</th>
                            <th>Amount</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var inv in allInvoices)
                        {
                            <tr>
                                <td>@(inv.InvoiceNumber ?? "N/A")</td>
                                <td>@(inv.Client?.Name ?? "N/A")</td>
                                <td>@(inv.DateIssued != null ? inv.DateIssued.ToString("yyyy-MM-dd") : "N/A")</td>
                                <td>₱@(String.Format("{0:N0}", inv.Amount))</td>
                                <td>@(inv.Status ?? "N/A")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </article>
    </div>

    <!-- PAGINATION -->
    <div class="table-pagination">
        <button class="pg-btn" onclick="changePage(-1)">‹</button>
        <span id="pageIndicator">Page 1</span>
        <button class="pg-btn" onclick="changePage(1)">›</button>
    </div>

    <!-- CHARTS GRID -->
    <section class="chart-grid">
        <article class="mm-card chart-card">
            <div class="chart-card-header">
                <h2>📊 Monthly Sales Trend</h2>
            </div>
            <div class="chart-card-body">
                <canvas id="monthlySalesChart"></canvas>
            </div>
        </article>

        <article class="mm-card chart-card">
            <div class="chart-card-header">
                <h2>Sales by Service Type</h2>
            </div>
            <div class="chart-card-body chart-card-body--pie">
                <canvas id="serviceTypeChart"></canvas>
            </div>
        </article>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

    <script>
        // PDF export function
        function exportTableToPDF(tableID, filename = 'SalesReport') {
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF('p', 'pt', 'a4');
            const table = document.getElementById(tableID);

            html2canvas(table, { scale: 2 }).then(canvas => {
                const imgData = canvas.toDataURL('image/png');
                const imgProps = doc.getImageProperties(imgData);
                const pdfWidth = doc.internal.pageSize.getWidth() - 40;
                const pdfHeight = (imgProps.height * pdfWidth) / imgProps.width;

                doc.addImage(imgData, 'PNG', 20, 20, pdfWidth, pdfHeight);
                doc.save(filename + '.pdf');
            });
        }

        // Pagination
        const rowsPerPage = 10;
        let currentPage = 1;

        function renderTablePage() {
            const table = document.getElementById("allInvoicesTable");
            const rows = table.querySelectorAll("tbody tr");
            const totalPages = Math.ceil(rows.length / rowsPerPage);

            rows.forEach((row, index) => {
                row.style.display =
                    index >= (currentPage - 1) * rowsPerPage &&
                    index < currentPage * rowsPerPage
                        ? ""
                        : "none";
            });

            document.getElementById("pageIndicator").textContent =
                `Page ${currentPage} of ${totalPages}`;
            document.querySelectorAll(".pg-btn")[0].disabled = currentPage === 1;
            document.querySelectorAll(".pg-btn")[1].disabled = currentPage === totalPages;
        }

        function changePage(step) {
            const table = document.getElementById("allInvoicesTable");
            const rows = table.querySelectorAll("tbody tr");
            const totalPages = Math.ceil(rows.length / rowsPerPage);

            currentPage += step;
            if (currentPage < 1) currentPage = 1;
            if (currentPage > totalPages) currentPage = totalPages;

            renderTablePage();
        }

        renderTablePage();


        // Charts (with empty-data check)
        function setHiResCanvas(canvas) {
            const ctx = canvas.getContext('2d');
            const dpr = window.devicePixelRatio || 1;
            const rect = canvas.getBoundingClientRect();
            canvas.width = rect.width * dpr;
            canvas.height = rect.height * dpr;
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
            return ctx;
        }

        // Monthly Sales Chart
        const monthlyCanvas = document.getElementById('monthlySalesChart');
        if (monthlyCanvas && @monthlyRevenue.Count > 0) {
            const ctx = setHiResCanvas(monthlyCanvas);
            const gradient = ctx.createLinearGradient(0, 0, 0, monthlyCanvas.height);
            gradient.addColorStop(0, 'rgba(79,70,229,0.5)');
            gradient.addColorStop(1, 'rgba(79,70,229,0)');

            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(monthlyRevenue.Select(m => m.Month + "/" + m.Year))),
                    datasets: [{
                        label: 'Revenue (₱)',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(monthlyRevenue.Select(m => m.Revenue))),
                        borderWidth: 3,
                        borderColor: '#4f46e5',
                        backgroundColor: gradient,
                        tension: 0.4,
                        fill: true,
                        pointRadius: 6,
                        pointHoverRadius: 8,
                        pointBackgroundColor: '#4f46e5',
                        pointHoverBackgroundColor: '#10b981',
                        pointBorderWidth: 2,
                        pointHoverBorderWidth: 2
                    }]
                },
                options: { responsive: true, maintainAspectRatio: false }
            });
        }

        // Service Type Chart
        const serviceCanvas = document.getElementById('serviceTypeChart');
        if (serviceCanvas && @serviceRevenue.Count > 0) {
            const ctx = setHiResCanvas(serviceCanvas);
            new Chart(ctx, {
                type: 'pie',
                data: {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(serviceRevenue.Select(s => s.ServiceType))),
                    datasets: [{
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(serviceRevenue.Select(s => s.Revenue))),
                        backgroundColor: ['#4f46e5','#10b981','#f59e0b','#ef4444','#6366f1'],
                        hoverOffset: 15,
                        borderWidth: 2,
                        borderColor: '#fff'
                    }]
                },
                options: { responsive: true, maintainAspectRatio: false }
            });
        }


    </script>
}