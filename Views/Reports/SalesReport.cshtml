@model Moonmax.ViewModels.SalesReportVM


@{
    ViewData["Title"] = "Reports & Analytics";
    ViewData["Nav"] = "Reports";
    ViewData["AppShell"] = true;
}

@{
    var generatedByUser = User.Identity?.IsAuthenticated == true
        ? User.Identity.Name
        : "Unknown User";
}


@section Styles {
    <link rel="stylesheet" href="~/css/tophead.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/reports.css" asp-append-version="true" />
}

<div class="page page-reports">

    <!-- HEADER -->
    <header class="dash-header">
        <div>
            <h1 class="dash-title">Sales Reports</h1>
            <p class="dash-sub">Generate sales reports</p>

            <!--Back Button-->
            <div>
                <button id="btnBack" class="modern-btn modern-btn-back"><i class="fa-solid fa-arrow-left"></i> Back</button>
            </div>
        </div>
    </header>

    <!-- KPIs -->
    <section class="section-block">
        <div class="dash-kpis">
            <article class="dash-card kpi">
                <div class="kpi-icon"><i class="fa-solid fa-peso-sign"></i></div>
                <div class="kpi-content">
                    <div class="kpi-title">Total Revenue</div>
                    <div class="kpi-main">₱@(ViewBag.TotalRevenue?.ToString("N2") ?? "0.00")</div>
                </div>
            </article>

            <article class="dash-card kpi">
                <div class="kpi-icon"><i class="fa-solid fa-file-invoice"></i></div>
                <div class="kpi-content">
                    <div class="kpi-title">Invoices Issued</div>
                    <div class="kpi-main">@((ViewBag.InvoiceCount ?? 0).ToString())</div>
                </div>
            </article>

            <article class="dash-card kpi">
                <div class="kpi-icon"><i class="fa-solid fa-chart-simple"></i></div>
                <div class="kpi-content">
                    <div class="kpi-title">Avg Invoice Value</div>
                    <div class="kpi-main">₱@(ViewBag.AvgInvoiceValue?.ToString("N2") ?? "0.00")</div>
                </div>
            </article>

            <article class="dash-card kpi">
                <div class="kpi-icon"><i class="fa-solid fa-star"></i></div>
                <div class="kpi-content">
                    <div class="kpi-title">Top Service Type</div>
                    <div class="kpi-main">@ViewBag.TopServiceRevenue</div>
                </div>
            </article>
        </div>

    </section>


    <!-- SALES REPORTS -->
    <section class="section-block">
        <h2 class="section-title">Sales Reports</h2>

        <!-- DATE RANGE & EXPORT -->
        <section class="section-block filters-export">
            <div class="filters modern-filters">
                <div class="date-range">
                    <label>From:</label>
                    <input type="date" id="reportFromDate" value="@DateTime.Now.AddDays(-30).ToString("yyyy-MM-dd")" class="modern-input modern-date" />
                    <label>To:</label>
                    <input type="date" id="reportToDate" value="@DateTime.Now.ToString("yyyy-MM-dd")" class="modern-input modern-date" />

                    <button id="btnApplyFilter" class="modern-btn modern-btn-export" style="flex:1; min-width:120px; background-color:#4F46E5; color:#fff;">
                        <i class="fa-solid fa-filter"></i> Apply Filter
                    </button>
                </div>

                <div class="report-actions" style="display:flex; flex-wrap:wrap; gap:10px; margin-top:10px; align-items:center;">
                    <!-- Status Drop-down -->
                    <select id="statusFilter" class="modern-input" style="min-width:150px;">
                        <option value="">All Statuses</option>
                        <option value="Pending">Pending</option>
                        <option value="Paid">Paid</option>
                    </select>

                    <!-- Export Button -->
                    <button id="btnExportPdf" class="modern-btn modern-btn-export" style="flex:1; min-width:120px; background-color:#4F46E5; color:#fff;">
                        <i class="fa-solid fa-file-pdf"></i> Export PDF
                    </button>
                </div>

            </div>
        </section>



        <!-- Invoice Table -->
        <div class="mm-card table-card">
            <header class="chart-card-header">
                <h3>Invoices</h3>
                <p>List of invoices within the selected date range.</p>
            </header>
            <!-- Invoice Table -->
            <div class="table-responsive" style="margin-bottom: 30px;">
                <table id="invoiceTable" class="modern-table striped hover" style="width:100%; table-layout:fixed;">
                    <thead>
                        <tr>
                            <th>Invoice #</th>
                            <th>Client</th>
                            <th>Service Type</th>
                            <th>Amount</th>
                            <th>Payment Type</th>
                            <th>Date Issued</th>
                            <th>Payment Due</th> <!-- NEW -->
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.InvoiceReport != null && Model.InvoiceReport.Any())
                        {
                            foreach (var inv in Model.InvoiceReport)
                            {
                                <tr>
                                    <td>@inv.InvoiceNumber</td>
                                    <td>@inv.ClientName</td>
                                    <td>@inv.ServiceType</td>
                                    <td>₱@inv.Amount.ToString("N2")</td>
                                    <td>@inv.PaymentType</td>
                                    <td>@inv.DateIssued.ToString("yyyy-MM-dd")</td>
                                    <td>@inv.DueDate</td> <!-- NEW -->
                                    <td>@inv.Status</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center">No invoices found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Mini Pagination -->
            <div class="table-pagination" style="text-align:center; margin-bottom: 20px;">
                <button class="pg-btn" onclick="changeInvoicePage(-1)">‹</button>
                <span id="invoicePageIndicator">Page 1</span>
                <button class="pg-btn" onclick="changeInvoicePage(1)">›</button>
            </div>

        </div>



        <!-- Charts -->
        <div class="reports-row">
            <article class="mm-card chart-card chart-card--wide">
                <header class="chart-card-header">
                    <h3>Revenue Trend</h3>
                </header>
                <div class="chart-card-body">
                    <canvas id="salesTrendChart" style="height:300px;"></canvas>
                </div>
            </article>

            <article class="mm-card chart-card">
                <header class="chart-card-header">
                    <h3>Service Type Breakdown</h3>
                </header>
                <div class="chart-card-body">
                    <canvas id="serviceTypeChart" style="height:300px;"></canvas>
                </div>
            </article>
        </div>

    </section>


</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>


    <!--Back Button-->
    <script>
        document.getElementById('btnBack').addEventListener('click', function() {
            window.history.back(); // Goes back to the previous page
        });
    </script>

    <script>
        // Convert Model data to JS arrays
        const months = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Months));
        const monthlyRevenue = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyRevenue));
        const serviceTypes = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ServiceTypes));
        const serviceRevenue = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ServiceRevenue));

        function generateColors(length) {
            const palette = ['#4F46E5','#FACC15','#10B981','#EF4444','#1F2937','#8B5CF6','#F472B6','#10B981'];
            return Array.from({length}, (_, i) => palette[i % palette.length]);
        }

        // Line Chart - Revenue Trend
        new Chart(document.getElementById('salesTrendChart'), {
            type: 'line',
            data: {
                labels: months,
                datasets: [{
                    label: 'Revenue',
                    data: monthlyRevenue,
                    borderColor: '#4F46E5',
                    backgroundColor: 'rgba(79,70,229,0.2)',
                    fill: true,
                    tension: 0.3
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false, // allow canvas to respect height
                plugins: { legend: { display: true } },
                scales: { y: { beginAtZero: true } }
            }
        });

        // Pie Chart - Service Type Revenue
        new Chart(document.getElementById('serviceTypeChart'), {
            type: 'pie',
            data: {
                labels: serviceTypes,
                datasets: [{
                    data: serviceRevenue,
                    backgroundColor: generateColors(serviceRevenue.length)
                }]
            },
            options: { responsive: true,
            maintainAspectRatio: false, // allow canvas to respect height
            plugins: { legend: { position: 'right' } } }
        });
    </script>


    <!--Pagination-->
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const table = document.getElementById("invoiceTable");
            const rows = Array.from(table.querySelectorAll("tbody tr"));
            const rowsPerPage = 10;
            let currentPage = 1;

            function renderTablePage(page) {
                const totalPages = Math.ceil(rows.length / rowsPerPage) || 1;
                rows.forEach((row, index) => {
                    row.style.display = (index >= (page - 1) * rowsPerPage && index < page * rowsPerPage) ? "" : "none";
                });
                document.getElementById("invoicePageIndicator").textContent = `Page ${page} of ${totalPages}`;
                document.querySelectorAll(".table-pagination .pg-btn")[0].disabled = page === 1;
                document.querySelectorAll(".table-pagination .pg-btn")[1].disabled = page === totalPages;
            }

            window.changeInvoicePage = function(step) {
                const totalPages = Math.ceil(rows.length / rowsPerPage) || 1;
                currentPage += step;
                if (currentPage < 1) currentPage = 1;
                if (currentPage > totalPages) currentPage = totalPages;
                renderTablePage(currentPage);
            }

            renderTablePage(currentPage);
        });
    </script>


    <!-- Date Filter -->
    <script>
        document.getElementById('btnApplyFilter').addEventListener('click', function () {
            const from = document.getElementById('reportFromDate').value;
            const to = document.getElementById('reportToDate').value;

            if (!from || !to) {
                alert('Please select both From and To dates.');
                return;
            }

            const url = new URL(window.location.href);
            url.searchParams.set('fromDate', from);
            url.searchParams.set('toDate', to);
            window.location.href = url.toString();
        });
    </script>


    <script>
        const generatedByUser = "@generatedByUser";
    </script>


    <!-- Export button (FINAL FIX: date + status + pagination-safe + full summary) -->
    <script>
        document.getElementById('btnExportPdf').addEventListener('click', function () {
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF('p', 'mm', 'a4');

            // ===============================
            // FILTER VALUES
            // ===============================
            const fromDate = document.getElementById('reportFromDate').value;
            const toDate = document.getElementById('reportToDate').value;
            const selectedStatus = document.getElementById('statusFilter').value;

            const from = new Date(fromDate);
            const to = new Date(toDate);
            to.setHours(23, 59, 59, 999);

            const formattedFromDate = from.toLocaleDateString('en-US', {
                year: 'numeric', month: 'short', day: 'numeric'
            });

            const formattedToDate = to.toLocaleDateString('en-US', {
                year: 'numeric', month: 'short', day: 'numeric'
            });

            // ===============================
            // 🔥 STEP 1: FILTER ROWS FIRST
            // ===============================
            const allRows = Array.from(document.querySelectorAll('#invoiceTable tbody tr'));

            const filteredRows = allRows.filter(row => {
                const rowStatus = row.cells[7]?.textContent.trim();
                const rowDate = new Date(row.cells[5]?.textContent.trim());

                const matchesStatus = !selectedStatus || rowStatus === selectedStatus;
                const matchesDate = rowDate >= from && rowDate <= to;

                return matchesStatus && matchesDate;
            });

            // ===============================
            // 🔥 STEP 2: FILTER-AWARE SUMMARY
            // ===============================
            let totalRevenueValue = 0;
            let serviceTotals = {};
            let invoiceCount = filteredRows.length;

            filteredRows.forEach(row => {
                const amount = parseFloat(
                    row.cells[3].textContent.replace('₱', '').replace(/,/g, '')
                ) || 0;

                const serviceType = row.cells[2].textContent.trim();

                totalRevenueValue += amount;
                serviceTotals[serviceType] = (serviceTotals[serviceType] || 0) + amount;
            });

            const avgInvoiceValueValue = invoiceCount
                ? totalRevenueValue / invoiceCount
                : 0;

            let topServiceType = "N/A";
            let maxRevenue = 0;

            for (const service in serviceTotals) {
                if (serviceTotals[service] > maxRevenue) {
                    maxRevenue = serviceTotals[service];
                    topServiceType = service;
                }
            }

            const totalRevenue = `PHP ${totalRevenueValue.toLocaleString('en-US', { minimumFractionDigits: 2 })}`;
            const invoicesIssued = invoiceCount.toString();
            const avgInvoiceValue = `PHP ${avgInvoiceValueValue.toLocaleString('en-US', { minimumFractionDigits: 2 })}`;
            const jobsCompleted = filteredRows.filter(r => r.cells[7].textContent.trim() === 'Paid').length;

            // ===============================
            // HEADER
            // ===============================
            doc.setFont('helvetica', 'bold');
            doc.setFontSize(18);
            doc.text("SALES REPORT", 105, 20, { align: 'center' });

            doc.setFont('helvetica', 'normal');
            doc.setFontSize(10);
            doc.text(`Report Period: ${formattedFromDate} - ${formattedToDate}`, 105, 28, { align: 'center' });

            if (selectedStatus) {
                doc.setFontSize(9);
                doc.text(`Status Filter: ${selectedStatus}`, 105, 34, { align: 'center' });
            }

            doc.setFontSize(8);
            doc.setTextColor(100);
            doc.text(`Generated by: ${generatedByUser}`, 10, 38);
            doc.text(`Generated on: ${new Date().toLocaleString()}`, 10, 42);

            doc.line(10, 45, 200, 45);

            // ===============================
            // SUMMARY
            // ===============================
            let startY = 52;

        // 🔥 FIX 1: Set light background color (light gray)
        doc.setFillColor(245, 247, 250); // light dashboard-style background
        doc.roundedRect(10, startY, 190, 55, 3, 3, 'F');

        // 🔥 FIX 2: Reset text color to black
        doc.setTextColor(0);
        doc.setFontSize(12);
        doc.text("Report Summary", 105, startY + 7, { align: 'center' });

        const kpiY = startY + 15;
        const col = 63;

        doc.setFontSize(9);
        doc.text("Total Revenue (PHP):", 15, kpiY);
        doc.setFontSize(11);
        doc.text(totalRevenue, 15, kpiY + 5);

        doc.setFontSize(9);
        doc.text("Invoices Issued:", 15 + col, kpiY);
        doc.setFontSize(11);
        doc.text(invoicesIssued, 15 + col, kpiY + 5);

        doc.setFontSize(9);
        doc.text("Jobs Completed:", 15 + col * 2, kpiY);
        doc.setFontSize(11);
        doc.text(jobsCompleted.toString(), 15 + col * 2, kpiY + 5);

        const row2Y = kpiY + 18;
        doc.setFontSize(9);
        doc.text("Avg Invoice Value (PHP):", 15, row2Y);
        doc.setFontSize(11);
        doc.text(avgInvoiceValue, 15, row2Y + 5);

        doc.setFontSize(9);
        doc.text("Top Service Type:", 15 + col, row2Y);
        doc.setFontSize(11);
        doc.text(topServiceType, 15 + col, row2Y + 5);

        startY += 65;


            // ===============================
            // TABLE
            // ===============================
            if (!filteredRows.length) {
                doc.text("No invoices found for the selected filters.", 10, startY);
                doc.save("SalesReport.pdf");
                return;
            }

            const tableBody = filteredRows.map(row => {
                const c = row.cells;
                return [
                    c[0].textContent,
                    c[1].textContent,
                    c[2].textContent,
                    c[3].textContent.replace('₱', 'PHP '),
                    c[4].textContent,
                    c[5].textContent,
                    c[6].textContent,
                    c[7].textContent
                ];
            });

            doc.autoTable({
                startY,
                head: [['Invoice #', 'Client', 'Service Type', 'Amount', 'Payment', 'Date Issued', 'Due Date', 'Status']],
                body: tableBody,
                theme: 'striped',
                showHead: 'everyPage'
            });

            doc.save(`SalesReport_${fromDate}_to_${toDate}.pdf`);
        });
    </script>





    

}

