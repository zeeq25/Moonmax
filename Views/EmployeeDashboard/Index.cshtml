@model Moonmax.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Employee Dashboard";
    ViewData["Nav"] = "Dashboard";
    ViewData["AppShell"] = true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/tophead.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<div class="page page-dashboard">

    <!-- PAGE HEADER -->
    <header class="dash-header">
        <div>
            <h1 class="dash-title">Employee Dashboard</h1>
            <p class="dash-sub">Welcome back! Here's what's happening today.</p>
        </div>
    </header>

    <!-- LOW STOCK ALERT BANNER -->
    @if (Model.LowStockItems != null && Model.LowStockItems.Any())
    {
        <div class="low-stock-banner" id="lowStockBanner">
            <div class="low-stock-header">
                <div class="low-stock-icon">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>
                <div class="low-stock-title">
                    <h3>Low Stock Alert</h3>
                    <p>@Model.LowStockItems.Count item(s) need attention</p>
                </div>
                <button class="low-stock-dismiss" onclick="dismissLowStockBanner()">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <ul class="low-stock-list">
                @foreach (var item in Model.LowStockItems)
                {
                    <li class="low-stock-item">
                        <div class="low-stock-item-info">
                            <div class="low-stock-item-name">@item.ItemName</div>
                            <div class="low-stock-item-qty">
                                @item.Quantity units remaining
                            </div>
                        </div>
                        @if (item.Quantity <= item.CriticalLevel)
                        {
                            <span class="low-stock-badge critical">CRITICAL</span>
                        }
                        else
                        {
                            <span class="low-stock-badge">LOW</span>
                        }
                    </li>
                }
            </ul>

            <div class="low-stock-actions">
                <a asp-controller="Inventory" asp-action="Index" class="low-stock-btn low-stock-btn-primary">
                    <i class="fa-solid fa-boxes-stacked"></i>
                    View Inventory
                </a>
                <a asp-controller="Procurement" asp-action="CreatePurchaseOrder" class="low-stock-btn low-stock-btn-secondary">
                    <i class="fa-solid fa-cart-shopping"></i>
                    Create Purchase Order
                </a>
            </div>
        </div>
    }

    <!-- KPI CARDS (Employee version - no sales data) -->
    <section class="dash-kpis">

        <!-- Active Repairs -->
        <article class="dash-card kpi">
            <div class="kpi-icon">
                <i class="fa-regular fa-calendar-check"></i>
            </div>
            <div class="kpi-content">
                <div class="kpi-title">Active Repairs</div>
                <div class="kpi-main">@Model.ActiveRepairs</div>
            </div>
        </article>

        <!-- Completed Jobs -->
        <article class="dash-card kpi">
            <div class="kpi-icon">
                <i class="fa-solid fa-check"></i>
            </div>
            <div class="kpi-content">
                <div class="kpi-title">Completed Jobs (Month)</div>
                <div class="kpi-main">@Model.CompletedJobsMonth</div>
            </div>
        </article>

        <!-- Inventory Stock -->
        <article class="dash-card kpi">
            <div class="kpi-icon">
                <i class="fa-solid fa-boxes-stacked"></i>
            </div>
            <div class="kpi-content">
                <div class="kpi-title">Inventory Stock</div>
                <div class="kpi-main">@Model.TotalInventoryStock</div>
            </div>
        </article>

        <!-- New Work Orders Today -->
        <article class="dash-card kpi">
            <div class="kpi-icon">
                <i class="fa-solid fa-clipboard-list"></i>
            </div>
            <div class="kpi-content">
                <div class="kpi-title">New Work Orders (Today)</div>
                <div class="kpi-main">@Model.NewWorkOrders</div>
            </div>
        </article>

    </section>

    <!-- MAIN GRID -->
    <section class="dash-main-grid">

        <!-- Recent Activity -->
        <article class="panel-card activity-card">
            <header class="panel-card-header">
                <h2>Recent Activity</h2>
            </header>

            <ul class="activity-list">
                @if (Model.RecentActivity != null && Model.RecentActivity.Any())
                {
                    foreach (var activity in Model.RecentActivity)
                    {
                        <li class="activity-item">
                            <div class="activity-icon icon-green">
                                <i class="fa-solid fa-circle-info"></i>
                            </div>
                            <div class="activity-body">
                                <div class="activity-title">@activity</div>
                                <div class="activity-meta">System Log</div>
                            </div>
                            <div class="activity-time">Just now</div>
                        </li>
                    }
                }
                else
                {
                    <li class="activity-item">
                        <div class="activity-icon icon-blue">
                            <i class="fa-solid fa-info-circle"></i>
                        </div>
                        <div class="activity-body">
                            <div class="activity-title">No recent activity</div>
                            <div class="activity-meta">System</div>
                        </div>
                        <div class="activity-time">—</div>
                    </li>
                }
            </ul>
        </article>

        <!-- Today's Summary -->
        <article class="panel-card summary-card">
            <header class="panel-card-header panel-card-header--blue">
                <h2>Today's Summary</h2>
            </header>

            <div class="summary-row">
                <span class="summary-label">New Work Orders</span>
                <span class="summary-value">@Model.NewWorkOrders</span>
            </div>
            <div class="summary-row">
                <span class="summary-label">Completed Jobs</span>
                <span class="summary-value">@Model.CompletedJobsToday</span>
            </div>
        </article>

        <!-- Company Est -->
        <article class="company-card">
            <div class="company-inner">
                <div class="company-label">COMPANY EST.</div>
                <div class="company-date">October 1, 2015</div>
                <div class="company-meta">10+ years of excellence</div>
            </div>
        </article>
    </section>

    <!-- CHART GRID -->
    <section class="dash-chart-wrap">

        <!-- Work Orders + Quick Links -->
        <div class="dash-chart-row dash-chart-row--top">

            <!-- Work Orders Chart -->
            <article class="chart-card">
                <header class="chart-header">
                    <h3>Work Orders by Service</h3>
                </header>
                <div class="chart-body">
                    <canvas id="workOrdersChart"></canvas>
                </div>
            </article>

            <!-- Quick Links -->
            <article class="chart-card quick-card">
                <header class="chart-header">
                    <h3>Quick Links</h3>
                </header>
                <div class="quick-body">
                    <ul class="quick-links">
                        <li>
                            <a asp-controller="JobOrders" asp-action="Create" class="quick-link-btn">
                                <i class="fa-solid fa-clipboard-list"></i>
                                <span>Create Job Order</span>
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Procurement" asp-action="CreatePurchaseOrder" class="quick-link-btn">
                                <i class="fa-solid fa-file-invoice-dollar"></i>
                                <span>New Purchase Order</span>
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Procurement" asp-action="CreateSupplier" class="quick-link-btn">
                                <i class="fa-solid fa-truck-field"></i>
                                <span>Add Supplier</span>
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Inventory" asp-action="Index" class="quick-link-btn">
                                <i class="fa-solid fa-box-open"></i>
                                <span>View Inventory</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </article>
        </div>

        <!-- Weekly Output + Inventory Value -->
        <div class="dash-chart-row dash-chart-row--bottom">

            <!-- Weekly Output -->
            <article class="chart-card">
                <header class="chart-header">
                    <h3>Weekly Output Trend</h3>
                </header>
                <div class="chart-body chart-body--small">
                    <canvas id="weeklyOutputChart"></canvas>
                </div>
            </article>

            <!-- Inventory Value -->
            <article class="chart-card">
                <header class="chart-header">
                    <h3>Inventory Stock Levels</h3>
                </header>
                <div class="chart-body chart-body--small">
                    <canvas id="inventoryValueChart"></canvas>
                </div>
            </article>
        </div>
    </section>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Work Orders Chart
        const workOrdersCtx = document.getElementById('workOrdersChart').getContext('2d');
        const workOrdersChart = new Chart(workOrdersCtx, {
            type: 'bar',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.WorkOrderServices)),
                datasets: [{
                    label: 'Job Orders',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.WorkOrderCounts)),
                    backgroundColor: 'rgba(54, 162, 235, 0.6)',
                    borderColor: 'rgba(54, 162, 235, 1)',
                    borderWidth: 1
                }]
            },
            options: { responsive: true, plugins: { legend: { display: false } } }
        });

        // Weekly Output Chart
        const weeklyCtx = document.getElementById('weeklyOutputChart').getContext('2d');
        const weeklyChart = new Chart(weeklyCtx, {
            type: 'line',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.WeeklyLabels)),
                datasets: [{
                    label: 'Completed Jobs',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.WeeklyOutput)),
                    fill: true,
                    borderColor: 'rgba(75, 192, 192, 1)',
                    backgroundColor: 'rgba(75, 192, 192, 0.2)',
                    tension: 0.3
                }]
            },
            options: { responsive: true }
        });

        // Inventory Value Chart
        const inventoryCtx = document.getElementById('inventoryValueChart').getContext('2d');
        const inventoryChart = new Chart(inventoryCtx, {
            type: 'bar',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.InventoryItems)),
                datasets: [{
                    label: 'Stock Quantity',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.InventoryValues)),
                    backgroundColor: 'rgba(255, 206, 86, 0.6)',
                    borderColor: 'rgba(255, 206, 86, 1)',
                    borderWidth: 1
                }]
            },
            options: { responsive: true, plugins: { legend: { display: false } } }
        });

        // Low Stock Banner Dismiss
        function dismissLowStockBanner() {
            const banner = document.getElementById('lowStockBanner');
            banner.style.animation = 'slideUp 0.3s ease-out';

            setTimeout(() => {
                banner.style.display = 'none';
                sessionStorage.setItem('lowStockDismissed', 'true');
            }, 300);
        }

        window.addEventListener('DOMContentLoaded', () => {
            const banner = document.getElementById('lowStockBanner');
            if (banner && sessionStorage.getItem('lowStockDismissed') === 'true') {
                banner.style.display = 'none';
            }
        });

        const style = document.createElement('style');
        style.textContent = `
            @@keyframes slideUp {
                from {
                    opacity: 1;
                    transform: translateY(0);
                }
                to {
                    opacity: 0;
                    transform: translateY(-20px);
                }
            }
        `;
        document.head.appendChild(style);
    </script>
}